# Ключи приложения Telegram. Получить: https://my.telegram.org → API development tools
# Скопируйте этот файл в .env (рядом с TgCheck.exe или в корень проекта) и впишите свои значения.

TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Необязательно: номер, который подставится в поле входа
# TG_PHONE=+79991234567

# Необязательно: прокси, если Telegram у провайдера работает плохо/заблокирован
#   MTProxy:  TG_PROXY=https://t.me/proxy?server=1.2.3.4&port=443&secret=ee...
#   SOCKS5:   TG_PROXY=socks5://127.0.0.1:1080   или   socks5://логин:пароль@хост:порт
# TG_PROXY=

# Необязательно: пользователи, которых приложение полностью игнорирует —
# их подарки, чаты, сообщения в группах и профиль скрыты. ID через запятую (можно ссылки tg://user?id=…)
# TG_IGNORE_IDS=

# Необязательно: GitHub-репозиторий с релизами для автообновления (owner/repo), если не задан при сборке
# TG_UPDATE_REPO=owner/tg-check

# Необязательно: папка для сессии, кэша и логов (по умолчанию %LOCALAPPDATA%\TgCheck)
# TG_DATA_DIR=%LOCALAPPDATA%\TgCheck
