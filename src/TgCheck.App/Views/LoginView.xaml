<UserControl x:Class="TgCheck.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TgCheck.App.Views"
             xmlns:helpers="clr-namespace:TgCheck.App.Helpers">

    <UserControl.Resources>
        <!-- Поле номера: после введённых цифр серым показывается остаток маски -->
        <Style x:Key="PhoneInput" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5">
                            <Grid>
                                <TextBlock Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}" IsHitTestVisible="False">
                                    <Run Text="{Binding MaskTyped, Mode=OneWay}" Foreground="Transparent" /><Run
                                         Text="{Binding MaskRest, Mode=OneWay}" Foreground="#4F6072" />
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка выбора страны в виде поля ввода -->
        <Style x:Key="CountryToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" Padding="14,11">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Surface3Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CountryItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле пароля с кнопкой «показать» -->
        <Style x:Key="EyeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Content" Value="&#xE890;" />
            <Setter Property="ToolTip" Value="Показать пароль" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                    <Setter Property="Content" Value="&#xED1A;" />
                    <Setter Property="ToolTip" Value="Скрыть пароль" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Panel}" Width="440" Padding="32,30" Margin="0,30"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Логотип: картинка из папки logo\ или стандартный значок -->
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource AccentBrush}"
                                 Visibility="{Binding Logo, Converter={StaticResource InvNullToVis}}" />
                        <Path Data="{StaticResource PlaneGeometry}" Fill="White" Stretch="Uniform" Margin="24,26,28,24"
                              Visibility="{Binding Logo, Converter={StaticResource InvNullToVis}}" />
                        <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Logo, Converter={StaticResource NullToVis}}" />
                    </Grid>

                    <TextBlock Text="TG Check" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,18,0,4" />
                    <TextBlock Text="Вход в аккаунт Telegram" Style="{StaticResource Muted}" HorizontalAlignment="Center" />

                    <!-- Переключатель способа входа -->
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="12" Padding="4" Margin="0,24,0,22">
                        <UniformGrid Columns="2">
                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="mode"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Phone}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE717;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="По номеру" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="mode"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Qr}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED14;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="По QR-коду" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <!-- ===================== Вход по номеру -->
                    <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVis}, ConverterParameter=Phone}">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" Padding="6"
                                    Margin="-6,0,6,0" ToolTip="Изменить номер" Command="{Binding BackCommand}"
                                    Visibility="{Binding Stage, Converter={StaticResource EnumToVis}, ConverterParameter='Code,Password,Email,EmailCode'}" />
                            <TextBlock Text="{Binding StageTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding StageHint}" Style="{StaticResource Muted}" Margin="0,0,0,14" />

                        <!-- Шаг 1: страна + номер -->
                        <StackPanel Visibility="{Binding Stage, Converter={StaticResource EnumToVis}, ConverterParameter=Phone}">
                            <ToggleButton x:Name="CountryButton" Style="{StaticResource CountryToggle}"
                                          IsChecked="{Binding IsCountryPickerOpen}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=CountryPopup, Converter={StaticResource InvBool}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Страна" Style="{StaticResource Caption}" FontSize="13" Width="62" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CountryName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </ToggleButton>

                            <Popup x:Name="CountryPopup" IsOpen="{Binding IsCountryPickerOpen}" StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=CountryButton}" Placement="Bottom" VerticalOffset="6"
                                   AllowsTransparency="True" PopupAnimation="Fade" Opened="CountryPopup_Opened"
                                   Width="{Binding ActualWidth, ElementName=CountryButton}">
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="12" Padding="8"
                                        BorderBrush="{StaticResource Surface3Brush}" BorderThickness="1" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBox x:Name="CountrySearchBox" Style="{StaticResource SearchBox}" Tag="Поиск страны или кода"
                                                 Text="{Binding CountrySearch, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="CountrySearchBox_PreviewKeyDown" />
                                        <ListBox x:Name="CountryList" ItemsSource="{Binding CountriesView}" MaxHeight="290" Margin="0,8,0,0"
                                                 Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource CountryItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 PreviewMouseLeftButtonUp="CountryList_PreviewMouseLeftButtonUp"
                                                 PreviewKeyDown="CountryList_PreviewKeyDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type helpers:Country}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CodeText}"
                                                                   Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0" />
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="CodeBox" Style="{StaticResource InputBox}" FontSize="17" Padding="30,13,8,13"
                                             MaxLength="5" Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewTextInput="DigitsOnly" PreviewKeyDown="CodeBox_PreviewKeyDown">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="+" FontSize="17" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                                <TextBox x:Name="NumberBox" Grid.Column="2" Style="{StaticResource PhoneInput}"
                                         Text="{Binding NationalNumber, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="DigitsOnly" PreviewKeyDown="NumberBox_PreviewKeyDown"
                                         TextChanged="NumberBox_TextChanged">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                        </StackPanel>

                        <!-- Шаг 2: код -->
                        <TextBox x:Name="CodeInput" Style="{StaticResource InputBox}" Tag="Код" FontSize="20"
                                 Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding Stage, Converter={StaticResource EnumToVis}, ConverterParameter='Code,EmailCode'}"
                                 IsVisibleChanged="FocusWhenVisible">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBox Style="{StaticResource InputBox}" Tag="you@example.com"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding Stage, Converter={StaticResource EnumToVis}, ConverterParameter=Email}"
                                 IsVisibleChanged="FocusWhenVisible">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Шаг 3: облачный пароль (2FA) -->
                        <StackPanel Visibility="{Binding Stage, Converter={StaticResource EnumToVis}, ConverterParameter=Password}">
                            <Grid>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}" Padding="16,13,50,13"
                                             PasswordChanged="PasswordBox_PasswordChanged" IsVisibleChanged="FocusWhenVisible"
                                             Visibility="{Binding ShowPassword, Converter={StaticResource InvBoolToVis}}">
                                    <PasswordBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
                                    </PasswordBox.InputBindings>
                                </PasswordBox>
                                <TextBox Style="{StaticResource InputBox}" Padding="16,13,50,13" Tag="Пароль"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible"
                                         Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Style="{StaticResource EyeButton}" Command="{Binding ToggleShowPasswordCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding PasswordHint, Converter={StaticResource NullToVis}}">
                                <Run Text="Подсказка:" /> <Run Text="{Binding PasswordHint, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="2,12,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />

                        <Button Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" Padding="18,13" Command="{Binding SubmitCommand}">
                            <Grid>
                                <TextBlock Text="{Binding SubmitText}"
                                           Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}" />
                                <views:Spinner Width="20" Height="20"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- ===================== Вход по QR -->
                    <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVis}, ConverterParameter=Qr}">
                        <StackPanel Visibility="{Binding QrNeedsPassword, Converter={StaticResource InvBoolToVis}}">
                            <Border Width="260" Height="260" CornerRadius="18" Background="White" Padding="16"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding QrImage}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <views:Spinner Visibility="{Binding QrImage, Converter={StaticResource InvNullToVis}}" />
                                    <Border Width="52" Height="52" CornerRadius="26" Background="White"
                                            Visibility="{Binding QrImage, Converter={StaticResource NullToVis}}">
                                        <Grid Margin="5">
                                            <Ellipse Fill="{StaticResource AccentBrush}" />
                                            <Path Data="{StaticResource PlaneGeometry}" Fill="White" Stretch="Uniform" Margin="10,11,12,10" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding QrStatus}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Margin="0,18,0,12" />

                            <StackPanel Margin="6,0">
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4">1. Откройте Telegram на телефоне</TextBlock>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4">2. Настройки → Устройства → Подключить устройство</TextBlock>
                                <TextBlock Style="{StaticResource Muted}">3. Наведите камеру на этот код</TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- 2FA после сканирования QR -->
                        <StackPanel Visibility="{Binding QrNeedsPassword, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Двухэтапная аутентификация" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="QR-код подтверждён. На аккаунте включён облачный пароль — введите его, чтобы завершить вход."
                                       Style="{StaticResource Muted}" Margin="0,0,0,14" />
                            <Grid>
                                <PasswordBox x:Name="QrPasswordBox" Style="{StaticResource InputPassword}" Padding="16,13,50,13"
                                             PasswordChanged="PasswordBox_PasswordChanged" IsVisibleChanged="FocusWhenVisible"
                                             Visibility="{Binding ShowPassword, Converter={StaticResource InvBoolToVis}}">
                                    <PasswordBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SubmitQrPasswordCommand}" />
                                    </PasswordBox.InputBindings>
                                </PasswordBox>
                                <TextBox Style="{StaticResource InputBox}" Padding="16,13,50,13" Tag="Пароль"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible"
                                         Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SubmitQrPasswordCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Style="{StaticResource EyeButton}" Command="{Binding ToggleShowPasswordCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding PasswordHint, Converter={StaticResource NullToVis}}">
                                <Run Text="Подсказка:" /> <Run Text="{Binding PasswordHint, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                            </TextBlock>
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" Padding="18,13"
                                    Command="{Binding SubmitQrPasswordCommand}">
                                <Grid>
                                    <TextBlock Text="Подтвердить пароль" Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}" />
                                    <views:Spinner Width="20" Height="20" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="2,14,0,0" TextAlignment="Center"
                                   Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />

                        <Button Content="Обновить QR-код" Style="{StaticResource SecondaryButton}" Margin="0,16,0,0"
                                Command="{Binding RetryQrCommand}"
                                Visibility="{Binding QrFailed, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Подключение: встроенный прокси, свой или напрямую -->
                    <StackPanel DataContext="{Binding Proxy}" Margin="0,22,0,0"
                                Visibility="{Binding Converter={StaticResource NullToVis}}">
                        <Button HorizontalAlignment="Center" Command="{Binding ToggleCommand}" Cursor="Hand" ToolTip="{Binding Tip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="10,6" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Подключение: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Margin="6,2,0,0"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Margin="0,8,0,0" Padding="16" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                            <views:ProxyPanel />
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0"
                               Text="Вход выполняется напрямую через официальный API Telegram. Сессия хранится только на этом компьютере в зашифрованном виде." />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
