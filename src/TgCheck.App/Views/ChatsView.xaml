<UserControl x:Class="TgCheck.App.Views.ChatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TgCheck.App.ViewModels"
             xmlns:views="clr-namespace:TgCheck.App.Views"
             xmlns:helpers="clr-namespace:TgCheck.App.Helpers"
             xmlns:controls="clr-namespace:TgCheck.App.Controls"
             x:Name="Root" SizeChanged="Root_SizeChanged">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="StoryRingBrush" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#2AABEE" Offset="0" />
            <GradientStop Color="#4FCE5D" Offset="1" />
        </LinearGradientBrush>

        <!-- Счётчик непрочитанных на вкладке -->
        <Style x:Key="TabBadge" TargetType="Border">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource Tint2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.FontSize" Value="11" />
            <Setter Property="TextElement.FontWeight" Value="Bold" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <!-- Аватар с кольцом историй -->
        <DataTemplate x:Key="Avatar48" DataType="{x:Type vm:PeerAvatarViewModel}">
            <controls:AvatarView Width="48" Height="48" Source="{Binding Avatar}" Fill="{Binding AvatarBrush}"
                                 Initials="{Binding Initials}" Ring="{Binding StoryRing}" />
        </DataTemplate>

        <Style x:Key="ChatListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="12" Margin="6,1" Padding="8,8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Layout" Margin="18,12,18,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="350" />
            <ColumnDefinition x:Name="GapColumn" Width="14" />
            <ColumnDefinition x:Name="ChatColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================= Список чатов -->
        <Border x:Name="ListPanel" Style="{StaticResource Panel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SearchRow" Height="Auto" />
                    <RowDefinition x:Name="StoriesRow" Height="Auto" />
                    <RowDefinition x:Name="TabsRow" Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="PlayerRow" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <Grid Margin="12,12,12,8">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" GotKeyboardFocus="SearchBox_GotFocus" LostKeyboardFocus="SearchBox_LostFocus" Padding="34,9,34,9" Tag="Поиск: чаты, люди, @ник, ссылка или ID"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="13,0,0,0" IsHitTestVisible="False"
                               HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <!-- Идёт глобальный поиск — маленький индикатор внутри поля, справа -->
                    <views:Spinner Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"
                                   Visibility="{Binding ShowSearchSpinner, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Связь оборвалась или ещё устанавливается: плашка поверх чатов внизу списка, ничего не сдвигает -->
                <Border Grid.Row="3" Panel.ZIndex="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10,0,10,12" Padding="12,7"
                        CornerRadius="14" Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsHitTestVisible="False" helpers:Anim.FadeOnVisible="True"
                        Visibility="{Binding Shell.ConnectionStatus, Converter={StaticResource NullToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.35" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <views:Spinner Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Shell.ConnectionStatus}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Истории -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="6,-6,6,6"
                              Visibility="Collapsed" helpers:Anim.Mode="SlideDown" helpers:Anim.Show="{Binding HasStories}"
                              PreviewMouseWheel="Stories_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Stories}" Margin="0,6,0,0"> <!-- запас сверху: увеличенная при наведении аватарка не обрезается -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StoryPeerViewModel}">
                                <Button Width="66" Margin="0,0,2,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                        Command="{Binding DataContext.OpenStoriesCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <StackPanel x:Name="P" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                                <StackPanel.RenderTransform>
                                                    <ScaleTransform x:Name="S" />
                                                </StackPanel.RenderTransform>
                                                <ContentPresenter />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15" />
                                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <controls:AvatarView Width="56" Height="56" HorizontalAlignment="Center" Source="{Binding Avatar}" Fill="{Binding AvatarBrush}"
                                                             Initials="{Binding Initials}" Ring="{Binding StoryRing}" />
                                        <TextBlock helpers:RichText.Text="{Binding ShortTitle}" helpers:RichText.EmojiSize="12" FontSize="11"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="62" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Вкладки / архив -->
                <Grid Grid.Row="2" Margin="12,0,12,8">
                    <DockPanel Visibility="{Binding ShowArchive, Converter={StaticResource InvBoolToVis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ToggleArchiveCommand}" Padding="8,6" Visibility="{Binding HasArchive, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="15" />
                                <Border Background="{DynamicResource Surface3Brush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="6,0,0,0"
                                        Visibility="{Binding ArchiveUnread, Converter={StaticResource NullToVis}}">
                                        <controls:BadgeText Text="{Binding ArchiveUnread}" FontSize="11" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <!-- Режим призрака: значок и ползунок; то же — Ctrl+G и раздел настроек -->
                        <CheckBox DockPanel.Dock="Right" Margin="0,0,4,0" VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                  DataContext="{x:Static vm:GhostViewModel.Instance}" IsChecked="{Binding IsEnabled}">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <!-- Всплывающие подсказки в программе выключены: эта — своя, только здесь -->
                                        <Popup IsOpen="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Placement="Bottom" AllowsTransparency="True" IsHitTestVisible="False" HorizontalOffset="-40" VerticalOffset="6">
                                            <Border CornerRadius="8" Padding="10,5" Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextBrush}">
                                                    <Run Text="Режим призрака ·" /> <Run Text="Ctrl+G" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </Border>
                                        </Popup>
                                        <Path x:Name="Ghost" Width="17" Height="17" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}"
                                              Data="F0 M12,2 C7.6,2 4,5.6 4,10 V22 L6.7,20 L9.3,22 L12,20 L14.7,22 L17.3,20 L20,22 V10 C20,5.6 16.4,2 12,2 Z M9,8 A1.6,1.6 0 1 1 9,11.2 A1.6,1.6 0 1 1 9,8 Z M15,8 A1.6,1.6 0 1 1 15,11.2 A1.6,1.6 0 1 1 15,8 Z" />
                                        <Grid Width="30" Height="16" VerticalAlignment="Center">
                                            <Border x:Name="Track" CornerRadius="8" Background="{DynamicResource Surface3Brush}" />
                                            <Ellipse x:Name="Knob" Width="10" Height="10" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                                        </Grid>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Ghost" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="tabs"
                                         IsChecked="{Binding Tab, Converter={StaticResource EnumToBool}, ConverterParameter=All}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Все" />
                                    <Border Style="{StaticResource TabBadge}" Visibility="{Binding AllUnread, Converter={StaticResource NullToVis}}">
                                        <controls:BadgeText Text="{Binding AllUnread}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="tabs"
                                         IsChecked="{Binding Tab, Converter={StaticResource EnumToBool}, ConverterParameter=Personal}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Личные" />
                                    <Border Style="{StaticResource TabBadge}" Visibility="{Binding PersonalUnread, Converter={StaticResource NullToVis}}">
                                        <controls:BadgeText Text="{Binding PersonalUnread}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Visibility="Collapsed" helpers:Anim.Mode="SlideDown" helpers:Anim.Show="{Binding ShowArchive}">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Padding="8" Command="{Binding ToggleArchiveCommand}" />
                        <TextBlock Text="Архив" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </DockPanel>
                </Grid>

                <!-- Чаты -->
                <ListBox x:Name="ChatList" Grid.Row="3" ItemsSource="{Binding ListSource}" SelectedItem="{Binding SelectedChat}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,0,6"
                         ItemContainerStyle="{StaticResource ChatListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="0.5,1"
                         helpers:SmoothScroll.IsEnabled="True">
                    <!-- Во время поиска в одном списке: сначала свои чаты, затем люди и каналы из глобального поиска -->
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type vm:ChatItemViewModel}">
                            <Grid Height="48" Loaded="ChatItem_Changed" DataContextChanged="ChatItem_DataContextChanged">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Tag="&#xE718;"
                                                  Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="Закрепить" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Header" Value="Открепить" />
                                                            <Setter Property="Tag" Value="&#xE77A;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Tag="&#xE7ED;"
                                                  Command="{Binding PlacementTarget.Tag.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="Выключить уведомления" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Header" Value="Включить уведомления" />
                                                            <Setter Property="Tag" Value="&#xEA8F;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Tag="&#xE7B8;"
                                                  Command="{Binding PlacementTarget.Tag.ToggleChatArchiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="Архивировать" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter Property="Header" Value="Вернуть из архива" />
                                                        </DataTrigger>
                                                        <!-- «Избранное» Telegram в архив не кладёт -->
                                                        <DataTrigger Binding="{Binding Peer.IsSelf}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Открыть профиль" Tag="&#xE77B;"
                                                  Command="{Binding PlacementTarget.Tag.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.Tag>
                                    <Binding Path="DataContext" ElementName="Root" />
                                </Grid.Tag>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar48}"
                                                      MouseLeftButtonUp="Avatar_MouseLeftButtonUp" />
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#4FCE5D" BorderThickness="2.5"
                                            BorderBrush="{DynamicResource SurfaceBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,-1,-1" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <Grid Grid.Column="1" Margin="11,1,2,1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource LinkBrush}"
                                                       Visibility="{Binding ShowChecks, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                <Setter Property="Text" Value="&#xE73E;&#xE73E;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock helpers:RichText.Text="{Binding Title}" helpers:RichText.EmojiSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                            <controls:StickerView CustomEmojiId="{Binding Peer.EmojiStatusId, TargetNullValue=0}" Visibility="{Binding Peer.EmojiStatusId, Converter={StaticResource NullToVis}}" Width="16" Height="16"
                                                                  Margin="4,0,0,0" Animate="False" />
                                            <TextBlock Text="&#xE74F;" Style="{StaticResource Icon}" FontSize="11" Margin="5,0,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Grid.Row="1">
                                        <Border DockPanel.Dock="Right" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" Margin="6,0,0,0"
                                                VerticalAlignment="Center" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MutedBadgeBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <controls:BadgeText Text="{Binding UnreadText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Непросмотренные реакции на ваши сообщения — красное сердечко, как в Telegram -->
                                        <Border DockPanel.Dock="Right" Width="20" Height="20" CornerRadius="10" Background="#E5534B" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasUnreadReactions, Converter={StaticResource BoolToVis}}">
                                            <Path Data="{StaticResource HeartGeometry}" Fill="White" Stretch="Uniform" Margin="5" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE718;" Style="{StaticResource Icon}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{x:Static views:ChatsView.PinVisibility}">
                                                    <Binding Path="IsPinned" />
                                                    <Binding Path="HasUnread" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <controls:TypingDots DockPanel.Dock="Left" DotBrush="{DynamicResource AccentBrush}" Margin="0,1,6,0"
                                                             Visibility="{Binding IsTyping, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock helpers:RichText.Text="{Binding LastText}" helpers:RichText.EmojiSize="15"
                                                   TextTrimming="CharacterEllipsis" FontSize="13" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTyping}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PeerResultViewModel}">
                            <Grid Height="48" Background="Transparent" Cursor="Hand" Loaded="ChatItem_Changed" DataContextChanged="ChatItem_DataContextChanged">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenGlobalCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                </Grid.InputBindings>
                                <DockPanel>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar48}" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock helpers:RichText.Text="{Binding Title}" helpers:RichText.EmojiSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>

                <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <views:Spinner />
                    <TextBlock Text="Загрузка чатов…" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Ничего не найдено" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="20"
                            Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" TextAlignment="Center" />
                    <Button Content="Повторить" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Center"
                            Command="{Binding LoadCommand}" />
                </StackPanel>

                <!-- История поиска: при фокусе на пустом поиске (как в Telegram) -->
                <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed"
                        helpers:Anim.Mode="Fade" helpers:Anim.Show="{Binding ShowRecentSearch}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="18,4,10,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Очистить" Padding="10,4" FontSize="12"
                                    Focusable="False" Command="{Binding ClearRecentSearchCommand}" />
                            <TextBlock Text="Недавние" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" helpers:SmoothScroll.IsEnabled="True">
                            <ItemsControl ItemsSource="{Binding RecentSearch}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChatItemViewModel}">
                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="12,6" Margin="6,0"
                                                Focusable="False" Foreground="{DynamicResource TextBrush}"
                                                Command="{Binding DataContext.OpenRecentSearchCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <DockPanel>
                                                <controls:AvatarView DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" Source="{Binding Avatar}"
                                                                     Fill="{Binding AvatarBrush}" Initials="{Binding Initials}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock helpers:RichText.Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Peer.Username, StringFormat=@{0}}" Style="{StaticResource Caption}"
                                                               Visibility="{Binding Peer.Username, Converter={StaticResource NullToVis}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ================================================= Открытый чат -->
        <Border x:Name="ChatPanel" Grid.Column="2" Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Conversation, Converter={StaticResource InvNullToVis}}">
                    <TextBlock Text="&#xE8BD;" Style="{StaticResource Icon}" FontSize="44" Foreground="{DynamicResource Surface3Brush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Выберите чат, чтобы начать общение" Style="{StaticResource Muted}" Margin="0,14,0,0" />
                </StackPanel>
                <!-- Готовые экраны последних чатов: переключение без пересборки ленты -->
                <Grid x:Name="ConversationsHost" />
            </Grid>
        </Border>

        <!-- ================================================= Подтверждение -->
        <Grid Grid.ColumnSpan="3" Margin="-18,-12,-18,-18" Visibility="Collapsed" helpers:Anim.Mode="Scale"
              helpers:Anim.Show="{Binding Confirm, Converter={x:Static views:ChatsView.NotNull}}">
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CancelConfirmCommand}" />
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource Panel}" Width="420" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Confirm.Title}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Confirm.Text}" Style="{StaticResource Muted}" FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Confirm.Text, Converter={StaticResource NullToVis}}" />
                    <!-- Галочка («Также удалить у …»): по умолчанию стоит; сняли — только у себя -->
                    <DockPanel Margin="0,16,0,0" Background="Transparent" Cursor="Hand" DataContext="{Binding Confirm.Check}"
                               Visibility="{Binding Converter={StaticResource NullToVis}}" MouseLeftButtonUp="ConfirmCheck_Click">
                        <CheckBox DockPanel.Dock="Left" Style="{StaticResource AppCheck}" IsChecked="{Binding IsChecked}" IsHitTestVisible="False" />
                        <TextBlock Text="{Binding Text}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <!-- Поле ввода (новое название, описание) -->
                    <TextBox x:Name="ConfirmInputBox" Margin="0,16,0,0" Padding="10,8" FontSize="14" DataContext="{Binding Confirm.Input}"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap"
                             MaxHeight="160" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}" BorderThickness="0"
                             Visibility="{Binding Converter={StaticResource NullToVis}}" IsVisibleChanged="ConfirmInputBox_IsVisibleChanged" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding CancelConfirmCommand}" />
                        <Button MinWidth="120" Command="{Binding AcceptConfirmCommand}" IsDefault="{Binding Confirm.Input, Converter={x:Static views:ChatsView.NotNull}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Confirm.IsDanger}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <TextBlock Text="{Binding Confirm.ActionText}" Visibility="{Binding IsWorking, Converter={StaticResource InvBoolToVis}}" />
                                <views:Spinner Width="18" Height="18" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
