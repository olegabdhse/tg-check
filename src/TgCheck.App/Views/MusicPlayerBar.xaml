<UserControl x:Class="TgCheck.App.Views.MusicPlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TgCheck.App.ViewModels"
             xmlns:controls="clr-namespace:TgCheck.App.Controls"
             xmlns:views="clr-namespace:TgCheck.App.Views"
             DataContext="{x:Static vm:MusicNow.Instance}">
    <!-- Плеер музыки: обложка с волнами, название и исполнитель, перемотка, повтор, пауза, закрыть -->
    <DockPanel>
        <controls:MusicWaves x:Name="Waves" DockPanel.Dock="Left" Width="58" Height="58" Margin="0,0,10,0" CoverRatio="0.7" BassPulse="True"
                             Cover="{Binding Cover}" CoverBrush="{Binding CoverBrush}" Level="{Binding Level}"
                             Progress="{Binding Progress}" IsPlaying="{Binding IsPlaying}" />
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" Padding="8" VerticalAlignment="Center"
                Click="Close_Click" ToolTip="Закрыть" />
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="13" Padding="7" VerticalAlignment="Center"
                Command="{Binding SeekEndCommand}" ToolTip="В конец" />
        <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Width="38" Height="38" Margin="4,0,2,0" VerticalAlignment="Center"
                Command="{Binding ToggleCommand}" ToolTip="Играть / пауза">
            <Grid>
            <!-- Догружается — вместо значка аккуратная загрузка (а не вид «остановлено») -->
            <Path Width="18" Height="18" Stretch="None" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M9,1.5 A7.5,7.5 0 1 1 1.5,9" RenderTransformOrigin="0.5,0.5"
                  Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVis}}">
                <Path.RenderTransform>
                    <RotateTransform />
                </Path.RenderTransform>
                <Path.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Path.Triggers>
            </Path>
            <TextBlock FontSize="14" Foreground="White" Visibility="{Binding IsBuffering, Converter={StaticResource InvBoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                        <Setter Property="Text" Value="&#xE768;" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Text" Value="&#xE769;" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>
        </Button>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="13" Padding="7" VerticalAlignment="Center"
                Command="{Binding SeekStartCommand}" ToolTip="В начало" />
        <!-- Повтор: подсвечен, когда включён -->
        <Button DockPanel.Dock="Right" Content="&#xE8EE;" FontSize="15" Padding="8" VerticalAlignment="Center"
                Command="{Binding ToggleLoopCommand}" ToolTip="Повторять">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Loop}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <!-- Перемотка: клик или перетаскивание по полоске -->
            <Grid x:Name="Seek" Height="14" Margin="0,4,0,0" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="Seek_Down" MouseMove="Seek_Move" MouseLeftButtonUp="Seek_Up">
                <Border Height="3" CornerRadius="1.5" Background="#33FFFFFF" VerticalAlignment="Center" />
                <Border Height="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Progress}" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
            <TextBlock x:Name="TimeLine" Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource MetaBrush}" />
        </StackPanel>
    </DockPanel>
</UserControl>
