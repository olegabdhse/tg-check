<UserControl x:Class="TgCheck.App.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TgCheck.App.ViewModels"
             xmlns:views="clr-namespace:TgCheck.App.Views"
             xmlns:helpers="clr-namespace:TgCheck.App.Helpers"
             x:Name="Root" Loaded="Root_Loaded" Unloaded="Root_Unloaded">

    <UserControl.Resources>
        <!-- Кнопка без фона (плитка, строка): подсветку рисует шаблон содержимого -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Обложка: градиент с буквой, поверх — картинка (когда загрузилась) -->
        <DataTemplate x:Key="CoverArt" DataType="{x:Type vm:MusicTrackViewModel}">
            <Grid>
                <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Background="{Binding CoverBrush}">
                    <!-- Нет обложки (или она ещё грузится) — белый самолётик Telegram -->
                    <Path Data="{StaticResource PlaneGeometry}" Fill="#B3FFFFFF" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource Mul}, ConverterParameter=0.38}"
                          Margin="0,0,2,0" />
                </Border>
                <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Плитка полки: обложка, при наведении — кнопка «играть», играющий — подсвечен -->
        <DataTemplate x:Key="Tile" DataType="{x:Type vm:MusicTrackViewModel}">
            <Button x:Name="TileButton" Style="{StaticResource PlainButton}" Width="156" Margin="0,0,14,0" ToolTip="{Binding Title}"
                    Command="{Binding DataContext.PlayCommand, ElementName=Root}" CommandParameter="{Binding}">
                <StackPanel>
                    <Grid Width="156" Height="156">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CoverArt}" Tag="14" Focusable="False" />
                        <Border x:Name="Shade" CornerRadius="14" Background="#73000000" Opacity="0" />
                        <Border x:Name="PlayDot" Width="46" Height="46" CornerRadius="23" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Opacity="0">
                            <TextBlock x:Name="PlayIcon" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="17" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="TileTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="2,1,2,0" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileButton}" Value="True">
                    <Setter TargetName="Shade" Property="Opacity" Value="1" />
                    <Setter TargetName="PlayDot" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="PlayDot" Property="Opacity" Value="1" />
                    <Setter TargetName="PlayIcon" Property="Text" Value="&#xE995;" />
                    <Setter TargetName="PlayIcon" Property="Margin" Value="0" />
                    <Setter TargetName="TileTitle" Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Плитка сетки «Дальше для вас»: ширина — по сетке, обложка квадратная -->
        <DataTemplate x:Key="GridTile" DataType="{x:Type vm:MusicTrackViewModel}">
            <Button x:Name="TileButton" Style="{StaticResource PlainButton}" Margin="0,0,14,0" ToolTip="{Binding Title}"
                    Command="{Binding DataContext.PlayCommand, ElementName=Root}" CommandParameter="{Binding}">
                <StackPanel>
                    <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CoverArt}" Tag="16" Focusable="False" />
                        <Border x:Name="Shade" CornerRadius="16" Background="#73000000" Opacity="0" />
                        <Border x:Name="PlayDot" Width="50" Height="50" CornerRadius="25" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Opacity="0">
                            <TextBlock x:Name="PlayIcon" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="TileTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="2,9,2,0" />
                    <TextBlock Text="{Binding Artist}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="2,1,2,0" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileButton}" Value="True">
                    <Setter TargetName="Shade" Property="Opacity" Value="1" />
                    <Setter TargetName="PlayDot" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="PlayDot" Property="Opacity" Value="1" />
                    <Setter TargetName="PlayIcon" Property="Text" Value="&#xE995;" />
                    <Setter TargetName="PlayIcon" Property="Margin" Value="0" />
                    <Setter TargetName="TileTitle" Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="GridSkeleton">
            <StackPanel Margin="0,0,14,0">
                <Border Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" CornerRadius="16" Background="{StaticResource Surface2Brush}" />
                <Border Height="12" Width="130" CornerRadius="6" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Left" Margin="2,12,0,0" />
                <Border Height="10" Width="86" CornerRadius="5" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Left" Margin="2,7,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Строка трека (поиск, история) -->
        <DataTemplate x:Key="Row" DataType="{x:Type vm:MusicTrackViewModel}">
            <Button x:Name="RowButton" Style="{StaticResource PlainButton}" Command="{Binding DataContext.PlayCommand, ElementName=Root}" CommandParameter="{Binding}">
                <Border x:Name="Bd" CornerRadius="10" Padding="8,6" Background="Transparent">
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,12,0">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CoverArt}" Tag="8" Focusable="False" />
                            <Border x:Name="Eq" CornerRadius="8" Background="#8C000000" Visibility="Collapsed">
                                <TextBlock Text="&#xE995;" Style="{StaticResource Icon}" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Button x:Name="RemoveBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="7"
                                VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Убрать из «Вы слушали»" Visibility="Collapsed"
                                Command="{Binding DataContext.RemoveFromHistoryCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,4,0" />
                        <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,1" Background="{StaticResource Surface3Brush}" VerticalAlignment="Center"
                                Visibility="{Binding ShowSource, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SourceText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="RowTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Artist, Mode=OneWay}" /><Run x:Name="Plays" Text="{Binding PlaysText, StringFormat=' · {0}', Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowButton}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=RowButton}" Value="True" />
                        <Condition Binding="{Binding IsHistory}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding PlaysText}" Value="{x:Null}">
                    <Setter TargetName="Plays" Property="Text" Value="" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Eq" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RowTitle" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Пока грузится: мягко «дышащие» серые заготовки плиток и строк (одна анимация на всю полку) -->
        <Style x:Key="Pulse" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="PulseAnim">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.8">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseAnim" />
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TileSkeleton">
            <StackPanel Width="156" Margin="0,0,14,0">
                <Border Height="156" CornerRadius="14" Background="{StaticResource Surface2Brush}" />
                <Border Height="12" Width="118" CornerRadius="6" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Left" Margin="2,11,0,0" />
                <Border Height="10" Width="78" CornerRadius="5" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Left" Margin="2,7,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="RowSkeleton">
            <DockPanel Margin="8,6">
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="8" Background="{StaticResource Surface2Brush}" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <Border Height="12" Width="220" CornerRadius="6" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Left" />
                    <Border Height="10" Width="130" CornerRadius="5" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Left" Margin="0,7,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Полка: заголовок, «слушать всё», листание стрелками; плитки в одну строку -->
        <DataTemplate x:Key="Shelf" DataType="{x:Type vm:MusicShelf}">
            <StackPanel Margin="0,0,0,26" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12" Margin="0,0,8,0"
                                Command="{Binding DataContext.PlayShelfCommand, ElementName=Root}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Слушать" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Padding="8" Tag="{Binding ElementName=ShelfScroll}"
                                Click="ShelfLeft_Click" ToolTip="Назад" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Padding="8" Tag="{Binding ElementName=ShelfScroll}"
                                Click="ShelfRight_Click" ToolTip="Дальше" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </DockPanel>
                <Grid MinHeight="208">
                    <ItemsControl ItemsSource="{Binding Source={x:Static vm:MusicShelf.Placeholders}}" ItemTemplate="{StaticResource TileSkeleton}"
                                  Style="{StaticResource Pulse}" ClipToBounds="True"
                                  Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ScrollViewer x:Name="ShelfScroll" helpers:Anim.FadeOnVisible="True"
                                  Visibility="{Binding ShowSkeleton, Converter={StaticResource InvBoolToVis}}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Shelf_PreviewMouseWheel" PreviewMouseLeftButtonDown="Shelf_PreviewMouseDown"
                                  PreviewMouseMove="Shelf_PreviewMouseMove" PreviewMouseLeftButtonUp="Shelf_PreviewMouseUp">
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Tile}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Результаты поиска по источнику -->
        <DataTemplate x:Key="ResultGroup" DataType="{x:Type vm:MusicShelf}">
            <StackPanel Margin="0,0,0,22">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,2,0,0" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Source={x:Static vm:MusicShelf.RowPlaceholders}}" ItemTemplate="{StaticResource RowSkeleton}"
                              Style="{StaticResource Pulse}" Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Row}" helpers:Anim.FadeOnVisible="True"
                              Visibility="{Binding ShowSkeleton, Converter={StaticResource InvBoolToVis}}" />
                <TextBlock Text="Ничего не нашлось" Margin="8,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                        <Condition Binding="{Binding Items.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- ================================================= Главная и поиск -->
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" helpers:SmoothScroll.IsEnabled="True"
                      ScrollChanged="Page_ScrollChanged" IsVisibleChanged="Page_IsVisibleChanged">
            <StackPanel Margin="30,10,26,24">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Обновить подбор"
                            Command="{Binding LoadRecommendationsCommand}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Музыка" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="Песни из Telegram — подбор по тому, что вы слушаете" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Поиск сразу везде -->
                <Grid Margin="0,16,0,22" MaxWidth="560" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                    <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}" Padding="40,11,40,11" FontSize="14"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Исполнитель, песня…" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="42,0,0,0"
                               Visibility="{Binding IsSearch, Converter={StaticResource InvBoolToVis}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Padding="8" HorizontalAlignment="Right" Margin="0,0,6,0"
                            Command="{Binding ClearQueryCommand}" Visibility="{Binding IsSearch, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- «Дальше для вас»: 4 песни по трём последним — сеткой во всю ширину, без прокрутки -->
                <StackPanel DataContext="{Binding NextForYou}" Margin="0,0,0,28" MaxWidth="980" HorizontalAlignment="Left"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{x:Static views:MusicView.BothVisible}">
                            <Binding Path="IsVisible" />
                            <Binding Path="DataContext.IsSearch" ElementName="Root" />
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12" VerticalAlignment="Center"
                                Command="{Binding DataContext.PlayShelfCommand, ElementName=Root}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Слушать" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,0,-14,0">
                        <ItemsControl ItemsSource="{Binding Source={x:Static vm:MusicShelf.GridPlaceholders}}" ItemTemplate="{StaticResource GridSkeleton}"
                                      Style="{StaticResource Pulse}" Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GridTile}" helpers:Anim.FadeOnVisible="True"
                                      Visibility="{Binding ShowSkeleton, Converter={StaticResource InvBoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Shelves}" ItemTemplate="{StaticResource Shelf}"
                              Visibility="{Binding IsSearch, Converter={StaticResource InvBoolToVis}}" />
                <ItemsControl ItemsSource="{Binding SearchShelves}" ItemTemplate="{StaticResource ResultGroup}"
                              Visibility="{Binding IsSearch, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ================================================= Справа: альбомный плеер и «Вы слушали» -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ClipToBounds="True" DataContext="{x:Static vm:MusicNow.Instance}">
                    <!-- Фон — размытая обложка (рисуется один раз на трек). Кистью, а не картинкой: картинка растягивалась
                         по высоте под крупную обложку и выталкивала список ниже за край окна. -->
                    <Border Opacity="0.55" Margin="-60">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect Radius="70" KernelType="Gaussian" RenderingBias="Performance" />
                        </Border.Effect>
                        <Border.CacheMode>
                            <BitmapCache RenderAtScale="0.5" />
                        </Border.CacheMode>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#33000000" Offset="0" />
                                <GradientStop Color="{StaticResource SurfaceColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Margin="26,26,26,16">
                        <!-- Обложка альбома -->
                        <Grid Width="248" Height="248" HorizontalAlignment="Center">
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.55" />
                            </Grid.Effect>
                            <Border CornerRadius="18" Background="{Binding CoverBrush}" />
                            <Path Data="{StaticResource PlaneGeometry}" Fill="#B3FFFFFF" Stretch="Uniform" Width="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="0,0,6,0" Visibility="{Binding Cover, Converter={StaticResource InvNullToVis}}" />
                            <Border CornerRadius="18" Background="{StaticResource Surface2Brush}"
                                    Visibility="{Binding IsActive, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="&#xEC4F;" Style="{StaticResource Icon}" FontSize="64" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="18">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <views:Spinner Width="34" Height="34" Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBlock Text="{Binding Title, TargetNullValue='Ничего не играет'}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,20,0,0" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DataContext.PlayingNote, ElementName=Root}" FontSize="11.5" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"
                                   Visibility="{Binding DataContext.PlayingNote, ElementName=Root, Converter={StaticResource NullToVis}}" />

                        <!-- Перемотка -->
                        <Grid x:Name="Seek" Height="16" Margin="0,14,0,0" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="Seek_Down" MouseMove="Seek_Move" MouseLeftButtonUp="Seek_Up"
                              IsEnabled="{Binding IsActive}">
                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center" />
                            <Border Height="4" CornerRadius="2" Background="White" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Progress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />

                        <!-- Управление -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="&#xE8EE;" FontSize="15" Padding="10" VerticalAlignment="Center" Command="{Binding ToggleLoopCommand}" ToolTip="Повторять">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Loop}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="17" Padding="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Foreground="{StaticResource TextBrush}" Command="{Binding DataContext.PreviousCommand, ElementName=Root}" ToolTip="Предыдущий" />
                            <Button Style="{StaticResource RoundButton}" Width="58" Height="58" Margin="10,0" VerticalAlignment="Center"
                                    Click="PlayPause_Click" ToolTip="Играть / пауза">
                                <TextBlock FontSize="21" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Setter Property="Margin" Value="3,0,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                    <Setter Property="Margin" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="17" Padding="11" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Foreground="{StaticResource TextBrush}" Command="{Binding DataContext.NextCommand, ElementName=Root}" ToolTip="Следующий" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" Padding="12" VerticalAlignment="Center"
                                    Click="CloseMusic_Click" ToolTip="Закрыть плеер" IsEnabled="{Binding IsActive}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DataContext.NextUpText, ElementName=Root}" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>

                <DockPanel DockPanel.Dock="Top" Margin="22,10,16,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding History.Count}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="Вы слушали" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>
                <Grid>
                    <TextBlock Text="Здесь появятся песни, которые вы слушаете в чатах и здесь. Голосовые и музыка историй сюда не попадают."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="30,18" VerticalAlignment="Top"
                               Visibility="{Binding HasHistory, Converter={StaticResource InvBoolToVis}}" />
                    <ListBox ItemsSource="{Binding History}" ItemTemplate="{StaticResource Row}" Background="Transparent" BorderThickness="0"
                             Padding="10,0,6,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             helpers:SmoothScroll.IsEnabled="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Убрать из истории"
                                                      Command="{Binding PlacementTarget.Tag.RemoveFromHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
