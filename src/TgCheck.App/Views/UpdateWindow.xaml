<Window x:Class="TgCheck.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:TgCheck.App.Helpers"
        Title="Что нового" Width="520" Height="620" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- «Что нового»: описание релиза с GitHub; текст листается, кнопка обновления всегда внизу -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,20,24,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentBrush}" Margin="0,0,14,0">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,18,8" helpers:SmoothScroll.IsEnabled="True">
            <StackPanel x:Name="Notes" />
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,14,24,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Позже" Padding="18,10" Click="Later_Click" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Начать обновление" Padding="18,10" FontSize="14" Click="Start_Click" IsDefault="True" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
