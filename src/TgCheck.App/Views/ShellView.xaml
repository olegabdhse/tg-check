<UserControl x:Class="TgCheck.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TgCheck.App.ViewModels"
             xmlns:views="clr-namespace:TgCheck.App.Views"
             xmlns:helpers="clr-namespace:TgCheck.App.Helpers"
             xmlns:controls="clr-namespace:TgCheck.App.Controls">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ChatsViewModel}">
            <views:ChatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>

        <!-- Кнопка боковой панели -->
        <Style x:Key="RailButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="60" Height="56" Background="Transparent">
                            <Border x:Name="Bd" CornerRadius="12" Margin="6,2" Background="Transparent" />
                            <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,12"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================= Боковая панель -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14,0,12">
                <Grid DockPanel.Dock="Top" Width="38" Height="38" Margin="0,0,0,18">
                    <Ellipse Fill="{StaticResource AccentBrush}" Visibility="{Binding MyProfile.Logo, Converter={StaticResource InvNullToVis}}" />
                    <Path Data="{StaticResource PlaneGeometry}" Fill="White" Stretch="Uniform" Margin="9,10,10,9"
                          Visibility="{Binding MyProfile.Logo, Converter={StaticResource InvNullToVis}}" />
                    <Image Source="{Binding MyProfile.Logo}" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding MyProfile.Logo, Converter={StaticResource NullToVis}}" />
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Style="{StaticResource Caption}" FontSize="10"
                           HorizontalAlignment="Center" />
                <Button DockPanel.Dock="Bottom" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="19" Padding="10"
                        HorizontalAlignment="Center" Margin="0,0,0,8" ToolTip="Настройки" Command="{Binding ToggleSettingsCommand}" />
                <!-- Соединение: щит с галочкой — через прокси, полоски сигнала — напрямую; клик — свой прокси -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource IconButton}" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,2"
                        ToolTip="{Binding Proxy.Tip}" Command="{Binding Proxy.ToggleCommand}">
                    <Grid Width="20" Height="20">
                        <Grid Visibility="{Binding Proxy.UsesProxy, Converter={StaticResource BoolToVis}}">
                            <Path Data="M10,1.6 L16.8,4.3 V9.4 C16.8,13.6 14,16.9 10,18.4 C6,16.9 3.2,13.6 3.2,9.4 V4.3 Z"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                            <Path Data="M6.7,10 L9,12.3 L13.4,7.7" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Grid>
                        <Canvas Visibility="{Binding Proxy.UsesProxy, Converter={StaticResource InvBoolToVis}}">
                            <Rectangle Canvas.Left="2" Canvas.Top="12" Width="3" Height="5" RadiusX="1" RadiusY="1"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Rectangle Canvas.Left="6.5" Canvas.Top="9" Width="3" Height="8" RadiusX="1" RadiusY="1"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Rectangle Canvas.Left="11" Canvas.Top="6" Width="3" Height="11" RadiusX="1" RadiusY="1"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Rectangle Canvas.Left="15.5" Canvas.Top="3" Width="3" Height="14" RadiusX="1" RadiusY="1"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Grid>
                </Button>
                <StackPanel>
                    <RadioButton Style="{StaticResource RailButton}" GroupName="rail" ToolTip="Чаты"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Chats}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock Text="Чаты" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-12,0"
                                    Visibility="{Binding ChatsUnread, Converter={StaticResource NullToVis}}">
                                <controls:BadgeText Text="{Binding ChatsUnread}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailButton}" GroupName="rail" ToolTip="Мой профиль"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Profile}">
                        <StackPanel>
                            <controls:AvatarView Width="30" Height="30" HorizontalAlignment="Center" Source="{Binding MyProfile.Avatar}"
                                                 Fill="{Binding MyProfile.AvatarBrush}" Initials="{Binding MyProfile.Initials}"
                                                 Ring="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Профиль" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================= Контент (при открытых настройках сдвигается вправо) -->
        <Grid x:Name="ContentArea" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Height="12" />

            <!-- Баннер обновления -->
            <Border Grid.Row="1" Margin="18,10,18,0" CornerRadius="12" Padding="14,9" Background="#1F3A52"
                    helpers:Anim.FadeOnVisible="True"
                    Visibility="{Binding UpdateText, Converter={StaticResource NullToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Padding="6" FontSize="11"
                            Command="{Binding DismissUpdateCommand}" ToolTip="Позже" Margin="6,0,0,0"
                            Visibility="{Binding IsUpdating, Converter={StaticResource InvBoolToVis}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="14,6" Content="Обновить"
                            Command="{Binding InstallUpdateCommand}"
                            Visibility="{Binding IsUpdating, Converter={StaticResource InvBoolToVis}}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding UpdateText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <views:ChatsView x:Name="ChatsPage" DataContext="{Binding Chats}" />
                <views:ProfileView x:Name="MyProfilePage" DataContext="{Binding MyProfile}" Visibility="Collapsed" />
                <ContentControl x:Name="PageHost" Focusable="False" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- ================================================= Очистка кэша: вопрос → утка с веником и полоска → итог -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed" helpers:Anim.Mode="Scale" helpers:Anim.Show="{Binding IsClearDialogOpen}"
              DataContext="{Binding Settings}">
            <Border Background="{StaticResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseClearDialogCommand}" />
                </Border.InputBindings>
            </Border>
            <Border Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18" Padding="26,22,26,22"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <Grid Width="130" Height="130" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="56" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding CleanupSticker, Converter={StaticResource InvNullToVis}}" />
                        <controls:StickerView Media="{Binding CleanupSticker}" Animate="True"
                                              Visibility="{Binding CleanupSticker, Converter={StaticResource NullToVis}}" />
                    </Grid>
                    <TextBlock Text="{Binding ClearTitle}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding IsConfirmStage, Converter={StaticResource BoolToVis}}">
                        <Run Text="Сейчас кэш занимает" /> <Run Text="{Binding CacheSizeText, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="{Binding ClearResultText}" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Visibility="{Binding IsDoneStage, Converter={StaticResource BoolToVis}}" />

                    <!-- Полоска прогресса -->
                    <Grid Height="6" Margin="0,18,0,0" Visibility="{Binding IsConfirmStage, Converter={StaticResource InvBoolToVis}}">
                        <Border CornerRadius="3" Background="{StaticResource Surface2Brush}" />
                        <Border CornerRadius="3" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ClearProgress}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0"
                                Visibility="{Binding IsConfirmStage, Converter={StaticResource BoolToVis}}">
                        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" MinWidth="120" Margin="0,0,10,0" Command="{Binding CloseClearDialogCommand}" />
                        <Button Content="Очистить" Style="{StaticResource DangerButton}" MinWidth="120" Command="{Binding ClearCacheCommand}" />
                    </StackPanel>
                    <Button Content="Готово" Style="{StaticResource PrimaryButton}" MinWidth="140" HorizontalAlignment="Center" Margin="0,20,0,0"
                            Command="{Binding CloseClearDialogCommand}" Visibility="{Binding IsDoneStage, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================= Прокси -->
        <Grid Grid.ColumnSpan="2" Visibility="Collapsed" helpers:Anim.Mode="Fade" helpers:Anim.Show="{Binding IsOpen}" DataContext="{Binding Proxy}">
            <Border Background="{StaticResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}" />
                </Border.InputBindings>
            </Border>
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Padding="20,14,20,18"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Закрыть (Esc)"
                                Command="{Binding ToggleCommand}" />
                        <TextBlock Text="Прокси" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <views:ProxyPanel />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================= Настройки: тёмная панель выезжает слева, контент сдвигается,
             список чатов сжимается до аватарок; клик вне панели — закрыть -->
        <Border x:Name="SettingsShade" Grid.Column="1" Background="#33000000" Visibility="Collapsed" Margin="340,0,0,0"
                MouseLeftButtonDown="SettingsShade_MouseDown" />
        <Border x:Name="SettingsPanel" Grid.Column="1" Width="340" HorizontalAlignment="Left" Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="-1,0,0,0"
                DataContext="{Binding Settings}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SettingsShift" X="-340" />
            </Border.RenderTransform>
            <Border.Resources>
                <!-- Как в Telegram Desktop: ровные строки во всю ширину (иконка, текст, переключатель), разделы — тёмными полосами -->
                <Style x:Key="TgSwitch" TargetType="CheckBox">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="Row" Background="Transparent" Padding="22,10,20,10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="19"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Width="22" Margin="0,0,18,0" VerticalAlignment="Center" />
                                        <Grid DockPanel.Dock="Right" Width="34" Height="18" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Border x:Name="Track" CornerRadius="9" Background="{StaticResource Surface3Brush}" />
                                            <Ellipse Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="3,0">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform x:Name="KnobShift" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#0DFFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="TgRow" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Row" Background="Transparent" Padding="22,12,20,12">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="19"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Width="22" Margin="0,0,18,0" VerticalAlignment="Center" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#0DFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="TgSection" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Margin" Value="22,14,0,4" />
                </Style>
                <!-- Разделитель разделов — тонкая светлая линия -->
                <Style x:Key="TgDivider" TargetType="Border">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Background" Value="#24FFFFFF" />
                    <Setter Property="Margin" Value="22,8,0,0" />
                </Style>
            </Border.Resources>
            <DockPanel>
                <!-- Шапка: заголовок и закрыть -->
                <DockPanel DockPanel.Dock="Top" Margin="22,14,12,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Закрыть (Esc)"
                            Command="{Binding DataContext.ToggleSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Text="Настройки" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding DataContext.VersionText, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=TG Check {0}}"
                           Style="{StaticResource Caption}" Margin="22,10,0,14" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" helpers:SmoothScroll.IsEnabled="True">
                <StackPanel>
                    <!-- Профиль: аватар, имя, @ник — клик открывает свой профиль -->
                    <Button Cursor="Hand" FocusVisualStyle="{x:Null}" Foreground="{StaticResource TextBrush}"
                            Command="{Binding DataContext.OpenMyProfileFromSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Row" Background="Transparent" Padding="22,12,20,14">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#0DFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel DataContext="{Binding DataContext.MyProfile, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <controls:AvatarView DockPanel.Dock="Left" Width="64" Height="64" Source="{Binding Avatar}" Fill="{Binding AvatarBrush}" Initials="{Binding Initials}" />
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock helpers:RichText.Text="{Binding NameText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding UsernameText}" Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Border Style="{StaticResource TgDivider}" Margin="22,0,0,0" />
                    <TextBlock Text="Уведомления" Style="{StaticResource TgSection}" />
                    <CheckBox Style="{StaticResource TgSwitch}" Tag="&#xEA8F;" IsChecked="{Binding Notifications}">
                        <StackPanel>
                            <TextBlock Text="Всплывающие уведомления" />
                            <TextBlock Text="Когда окно свёрнуто или не в фокусе" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource TgSwitch}" Tag="&#xE767;" IsChecked="{Binding NotificationSound}" IsEnabled="{Binding Notifications}"
                              Content="Звук уведомлений" />
                    <CheckBox Style="{StaticResource TgSwitch}" Tag="&#xE7B8;" IsChecked="{Binding NotifyArchived}" IsEnabled="{Binding Notifications}">
                        <StackPanel>
                            <TextBlock Text="Чаты из архива" />
                            <TextBlock Text="Чаты без звука не уведомляют" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <Border Style="{StaticResource TgDivider}" />
                    <TextBlock Text="Интерфейс" Style="{StaticResource TgSection}" />
                    <CheckBox Style="{StaticResource TgSwitch}" Tag="&#xE8B9;" IsChecked="{Binding ShowStories}" Content="Истории над списком чатов" />
                    <CheckBox Style="{StaticResource TgSwitch}" Tag="&#xE737;" IsChecked="{Binding ShowIsland}">
                        <StackPanel>
                            <TextBlock Text="Островок при сворачивании" />
                            <TextBlock Text="Последние чаты сверху экрана" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource TgSwitch}" Tag="&#xE8D6;" IsChecked="{Binding ShowIslandMusic}" Content="Плеер музыки в островке" />

                    <Border Style="{StaticResource TgDivider}" />
                    <TextBlock Text="Данные и память" Style="{StaticResource TgSection}" />
                    <Button Style="{StaticResource TgRow}" Tag="&#xE74D;" Command="{Binding AskClearCacheCommand}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CacheSizeText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Очистить кэш" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================================================= Истории -->
        <Grid Grid.ColumnSpan="2" Visibility="Collapsed" helpers:Anim.Mode="Scale" helpers:Anim.Show="{Binding IsStoriesOpen}">
            <Border Background="#F5050A10" />
            <Grid DataContext="{Binding StoryViewer}" Margin="0,24">
                <!-- Карточка 9:16 -->
                <Grid x:Name="StoryCard" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Mul}, ConverterParameter=0.5625}"
                      HorizontalAlignment="Center" MaxWidth="460">
                    <Border CornerRadius="16" Background="#101820" />
                    <Grid helpers:RoundClip.Radius="16">
                        <Image x:Name="StoryPreview" Source="{Binding Image}" Stretch="UniformToFill" />
                        <!-- Видео истории: для каждой истории свой плеер (создаётся в коде), поверх превью -->
                        <Grid x:Name="StoryVideoHost" />
                        <!-- Затемнение сверху и снизу для читаемости -->
                        <Border VerticalAlignment="Top" Height="110">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#99000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border VerticalAlignment="Bottom" Height="160" Visibility="{Binding HasCaption, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#CC000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Зоны клика: назад / вперёд -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.35*" />
                                <ColumnDefinition Width="0.65*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="Transparent" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding PreviousCommand}" />
                                </Border.InputBindings>
                            </Border>
                            <Border Grid.Column="1" Background="Transparent" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NextCommand}" />
                                </Border.InputBindings>
                            </Border>
                        </Grid>

                        <!-- Сегменты прогресса -->
                        <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Top" Margin="10,10,10,0" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StorySegment}">
                                    <Grid Height="3.5" Margin="2,0">
                                        <Border CornerRadius="1.75" Background="#66FFFFFF" />
                                        <Border CornerRadius="1.75" Background="White" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Progress}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Автор -->
                        <DockPanel VerticalAlignment="Top" Margin="14,24,10,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Foreground="White"
                                    Command="{Binding CloseCommand}" ToolTip="Закрыть (Esc)" />
                            <Button Command="{Binding OpenProfileCommand}" HorizontalAlignment="Left" Cursor="Hand" Foreground="White" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                    <controls:AvatarView Width="38" Height="38" Source="{Binding Current.Avatar}" Fill="{Binding Current.AvatarBrush}"
                                                         Initials="{Binding Current.Initials}" Ring="White" />
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock helpers:RichText.Text="{Binding Current.Title}" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TimeText}" Foreground="#CCFFFFFF" FontSize="12" FontWeight="Normal" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <TextBlock helpers:RichText.Text="{Binding Story.Caption}" Foreground="White" TextWrapping="Wrap" FontSize="14"
                                   VerticalAlignment="Bottom" Margin="18,0,18,74" TextAlignment="Center" IsHitTestVisible="False" />

                        <!-- Низ истории: ответ и лайк (чужая) или просмотры (своя) — как в Telegram -->
                        <DockPanel VerticalAlignment="Bottom" Margin="12,0,12,14">
                            <Button DockPanel.Dock="Right" Width="44" Height="44" Margin="8,0,0,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    Command="{Binding ToggleLikeCommand}" ToolTip="Нравится"
                                    Visibility="{Binding CanLike, Converter={StaticResource BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Path x:Name="Heart" Width="26" Height="23" Stretch="Uniform" Stroke="White" StrokeThickness="2" Fill="Transparent"
                                                  Data="M12,21.4 L10.6,20.1 C5.4,15.4 2,12.3 2,8.5 C2,5.4 4.4,3 7.5,3 C9.2,3 10.9,3.8 12,5.1 C13.1,3.8 14.8,3 16.5,3 C19.6,3 22,5.4 22,8.5 C22,12.3 18.6,15.4 13.4,20.1 Z"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <ScaleTransform x:Name="HeartScale" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Liked}" Value="True">
                                                <Setter TargetName="Heart" Property="Fill" Value="#FF3B5C" />
                                                <Setter TargetName="Heart" Property="Stroke" Value="#FF3B5C" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleX" From="0.6" To="1" Duration="0:0:0.35">
                                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleY" From="0.6" To="1" Duration="0:0:0.35">
                                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Своя история: просмотры -->
                            <Button Style="{StaticResource BareButton}" HorizontalAlignment="Left" Command="{Binding ToggleViewersCommand}" Foreground="White"
                                    Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ViewsText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- Чужая история: ответ уходит автору в личный чат -->
                            <Border CornerRadius="22" BorderBrush="#88FFFFFF" BorderThickness="1" Background="#33000000" Padding="4,0"
                                    Visibility="{Binding CanReply, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE724;" Foreground="White" Padding="8"
                                            Command="{Binding SendReplyCommand}" ToolTip="Отправить" />
                                    <Grid>
                                        <TextBlock Text="Ответить…" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False"
                                                   Visibility="{Binding ReplyText, Converter={StaticResource InvNullToVis}}" />
                                        <TextBox x:Name="StoryReply" Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                                 BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="14" Padding="10,11" VerticalContentAlignment="Center"
                                                 GotKeyboardFocus="StoryReply_GotFocus" LostKeyboardFocus="StoryReply_LostFocus" PreviewKeyDown="StoryReply_KeyDown" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <!-- Своя история: кто посмотрел -->
                        <Border VerticalAlignment="Bottom" MaxHeight="360" Margin="0" CornerRadius="16,16,0,0" Background="#F2141C25"
                                Visibility="Collapsed" helpers:Anim.Mode="SlideUp" helpers:Anim.Show="{Binding IsViewersOpen}">
                            <DockPanel Margin="0,10,0,6">
                                <DockPanel DockPanel.Dock="Top" Margin="16,0,8,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Foreground="White"
                                            Command="{Binding ToggleViewersCommand}" />
                                    <TextBlock Text="{Binding ViewsText}" Foreground="White" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" helpers:SmoothScroll.IsEnabled="True">
                                    <ItemsControl ItemsSource="{Binding Viewers}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:StoryViewerViewModel}">
                                                <DockPanel Margin="16,6" Background="Transparent" Cursor="Hand" ToolTip="Открыть профиль">
                                                    <DockPanel.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenViewerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}" />
                                                    </DockPanel.InputBindings>
                                                    <controls:AvatarView DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,12,0" Source="{Binding Avatar}"
                                                                         Fill="{Binding AvatarBrush}" Initials="{Binding Initials}" />
                                                    <TextBlock DockPanel.Dock="Right" helpers:RichText.Text="{Binding Reaction}" helpers:RichText.EmojiSize="20"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock helpers:RichText.Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TimeText}" Foreground="#AAFFFFFF" FontSize="12" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <views:Spinner Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Уведомление -->
        <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                CornerRadius="12" Padding="18,12" MaxWidth="640" helpers:Anim.FadeOnVisible="True"
                Visibility="{Binding Toast, Converter={StaticResource NullToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F0223140" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                            <Setter Property="Background" Value="#F07A2622" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.4" />
            </Border.Effect>
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding HideToastCommand}" />
            </Border.InputBindings>
            <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" Foreground="White" />
        </Border>
    </Grid>
</UserControl>
