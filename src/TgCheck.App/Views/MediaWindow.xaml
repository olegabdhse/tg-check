<Window x:Class="TgCheck.App.Views.MediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TgCheck.App.Controls"
        xmlns:helpers="clr-namespace:TgCheck.App.Helpers"
        xmlns:views="clr-namespace:TgCheck.App.Views"
        Title="Медиа" Width="960" Height="680" MinWidth="420" MinHeight="320"
        WindowStartupLocation="Manual" Background="#FF05090E"
        FontFamily="{StaticResource UiFont}" Foreground="White" UseLayoutRounding="True">
    <!-- Просмотр фото / видео в отдельном окне: живёт независимо от основного (свёрнуть, закрыть чат — оно остаётся) -->
    <Grid>
        <Grid Margin="16,44,16,72">
            <Image Source="{Binding Image}" helpers:RoundClip.Radius="10" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding IsVideo, Converter={StaticResource InvBoolToVis}}" />
            <Image Source="{Binding Current.Preview}" helpers:RoundClip.Radius="10" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
            <controls:VlcVideoView x:Name="VideoPlayer" SourcePath="{Binding VideoPath}"
                                   MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded" MediaFailed="VideoPlayer_MediaFailed"
                                   Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#CC0B1016" CornerRadius="12" Padding="18,14"
                    Visibility="{Binding VideoFailed, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Это видео не открывается встроенным плеером" FontSize="14" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Открыть в плеере" Margin="0,12,0,0" HorizontalAlignment="Center"
                            Click="OpenExternally_Click" />
                </StackPanel>
            </Border>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <views:Spinner />
                <TextBlock Text="{Binding Progress, StringFormat={}{0:P0}}" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="22" Padding="14" Margin="10,0,0,0" Foreground="White"
                HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Предыдущее (←)" Click="Prev_Click"
                Visibility="{Binding HasPrev, Converter={StaticResource BoolToVis}}" />
        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="22" Padding="14" Margin="0,0,10,0" Foreground="White"
                HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Следующее (→)" Click="Next_Click"
                Visibility="{Binding HasNext, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding Counter}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" />

        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Padding="12,8" CornerRadius="14" Background="#CC17212B">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" Foreground="White" Click="PlayPause_Click" />
                    <Slider x:Name="SeekSlider" Style="{StaticResource MediaSlider}" Width="300" VerticalAlignment="Center" Minimum="0" Maximum="1" Margin="8,0"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp" />
                    <TextBlock x:Name="VideoTime" FontSize="12" VerticalAlignment="Center" Width="90" />
                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" Foreground="White" Click="Mute_Click" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Foreground="White" Content="&#xE74E;" ToolTip="Сохранить" Click="Save_Click" />
                <Button x:Name="TopmostButton" Style="{StaticResource IconButton}" Foreground="White" Content="&#xE718;" ToolTip="Поверх всех окон" Click="Topmost_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
