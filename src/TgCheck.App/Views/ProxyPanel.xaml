<UserControl x:Class="TgCheck.App.Views.ProxyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Выбор подключения (DataContext — ProxyChoiceViewModel): встроенный прокси, свой или напрямую -->
    <StackPanel>
        <TextBlock Text="{Binding Tip}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13" />
        <TextBlock Text="Свой прокси: ссылка https://t.me/proxy?… или socks5://… — переподключимся через него."
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10" />
        <TextBox Style="{StaticResource InputBox}" Text="{Binding ProxyText, UpdateSourceTrigger=PropertyChanged}" Tag="https://t.me/proxy?server=…" />
        <TextBlock Text="{Binding ProxyError}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding ProxyError, Converter={StaticResource NullToVis}}" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Встроенный" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding BuiltInCommand}"
                    Visibility="{Binding CanUseBuiltIn, Converter={StaticResource BoolToVis}}" />
            <Button Content="Без прокси" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding NoProxyCommand}"
                    Visibility="{Binding UsesProxy, Converter={StaticResource BoolToVis}}" />
            <Button Content="Подключиться" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
