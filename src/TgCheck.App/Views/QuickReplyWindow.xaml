<Window x:Class="TgCheck.App.Views.QuickReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TgCheck.App.ViewModels"
        xmlns:controls="clr-namespace:TgCheck.App.Controls"
        xmlns:helpers="clr-namespace:TgCheck.App.Helpers"
        Title="TG Check — быстрый ответ" Width="340" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource TextBrush}" UseLayoutRounding="True">

    <!-- Обычное окно: углы и тень рисует Windows -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <StackPanel x:Name="Card" Margin="12,10,12,12">
        <!-- Шапка: чат, «открыть полностью», закрыть -->
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Padding="7" ToolTip="Закрыть (Esc)"
                    Click="Close_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE740;" FontSize="12" Padding="7" ToolTip="Открыть чат целиком"
                    Click="OpenFull_Click" />
            <controls:AvatarView DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" Source="{Binding Avatar}"
                                 Fill="{Binding AvatarBrush}" Initials="{Binding Initials}" />
            <TextBlock helpers:RichText.Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Последние сообщения -->
        <ItemsControl x:Name="Recent" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MessageViewModel}">
                    <Border x:Name="Bubble" CornerRadius="12" Padding="10,6" Margin="0,0,0,6" HorizontalAlignment="Left" MaxWidth="290"
                            Background="#FF182533">
                        <StackPanel>
                            <TextBlock Text="{Binding SenderName}" Foreground="{Binding SenderBrush}" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVis}}" />
                            <TextBlock x:Name="Body" helpers:RichText.Text="{Binding Item.Preview}" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                       MaxHeight="76" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource MetaBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOut}" Value="True">
                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Bubble" Property="Background" Value="#FF2B5278" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasText}" Value="True">
                            <Setter TargetName="Body" Property="helpers:RichText.Text" Value="{Binding Text}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="Empty" Text="Загрузка…" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,8" />

        <!-- Ответ -->
        <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Width="38" Height="38" Margin="8,0,0,0" Style="{StaticResource RoundButton}" Click="Send_Click"
                    ToolTip="Отправить (Enter)">
                <Path Data="{StaticResource PlaneGeometry}" Fill="White" Stretch="Uniform" Width="15" Height="15" Margin="0,0,2,0" />
            </Button>
            <TextBox x:Name="Input" Style="{StaticResource InputBox}" FontSize="13" Padding="12,9" Tag="Ответить…" TextWrapping="Wrap" MaxHeight="100"
                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Input_PreviewKeyDown" />
        </DockPanel>
    </StackPanel>
</Window>
