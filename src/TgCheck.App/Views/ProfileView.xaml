<UserControl x:Class="TgCheck.App.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TgCheck.App.ViewModels"
        xmlns:controls="clr-namespace:TgCheck.App.Controls"
             xmlns:views="clr-namespace:TgCheck.App.Views"
             xmlns:helpers="clr-namespace:TgCheck.App.Helpers"
             x:Name="Root" Focusable="True" SizeChanged="Root_SizeChanged">

    <UserControl.Resources>
        <!-- Маленькая звезда Telegram Stars -->
        <Style x:Key="StarIcon" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource StarGeometry}" />
            <Setter Property="Fill" Value="{StaticResource GoldGradientBrush}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>

        <!-- Карточка подарка -->
        <DataTemplate x:Key="GiftCard" DataType="{x:Type vm:GiftViewModel}">
            <Button Style="{StaticResource CardButton}"
                    Command="{Binding DataContext.OpenGiftCommand, ElementName=Root}" CommandParameter="{Binding}">
                <StackPanel>
                    <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" Margin="8,8,8,0">
                        <Border CornerRadius="12" Background="{StaticResource Surface2Brush}" />
                        <Border CornerRadius="12" Background="{Binding Backdrop}"
                                Visibility="{Binding Backdrop, Converter={StaticResource NullToVis}}" />
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <views:Spinner Width="22" Height="22" Opacity="0.6"
                                       Visibility="{Binding Image, Converter={StaticResource InvNullToVis}}" />

                        <!-- Бейджи -->
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7"
                                Visibility="{Binding Badge, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7">
                            <Border Style="{StaticResource Pill}" Margin="4,0,0,0" ToolTip="Закреплён в профиле"
                                    Visibility="{Binding Item.IsPinned, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE718;" Style="{StaticResource Icon}" FontSize="11" Foreground="White" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="4,0,0,0" ToolTip="Скрыт из профиля"
                                    Visibility="{Binding Item.IsHidden, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xED1A;" Style="{StaticResource Icon}" FontSize="11" Foreground="White" />
                            </Border>
                        </StackPanel>

                        <!-- Выбор для продажи -->
                        <CheckBox Style="{StaticResource RoundCheck}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                  IsChecked="{Binding IsSelected}">
                            <CheckBox.Visibility>
                                <MultiBinding Converter="{x:Static views:ProfileView.AllTrueToVisibility}">
                                    <Binding Path="DataContext.SelectionMode" ElementName="Root" />
                                    <Binding Path="CanConvert" />
                                </MultiBinding>
                            </CheckBox.Visibility>
                        </CheckBox>

                        <!-- Мини-аватар отправителя -->
                        <controls:AvatarView Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7"
                                             ToolTip="{Binding FromText}" Source="{Binding SenderAvatar}" Ring="#E6FFFFFF"
                                             Visibility="{Binding SenderAvatar, Converter={StaticResource NullToVis}}" />
                    </Grid>

                    <StackPanel Margin="12,10,12,12">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Path Style="{StaticResource StarIcon}" Width="11" Height="11"
                                  Visibility="{Binding ShowStarInSubtitle, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Плитка статистики -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================= Верхняя панель -->
        <DockPanel Margin="22,8,18,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Назад" Command="{Binding GoBackCommand}" Margin="-8,0,6,0"
                        Visibility="{Binding IsOther, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding PageTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Обновить" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- ================================================= Контент -->
        <Grid Grid.Row="1" Margin="18,12,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="InfoColumn" Width="370" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Профиль -->
            <Border Style="{StaticResource Panel}" Padding="0">
                <DockPanel>
                <!-- Низ панели: выход (свой профиль) или «Написать» (чужой) -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                    <Grid>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch"
                                Foreground="{StaticResource DangerBrush}" Padding="12,10"
                                Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF3B1;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Выйти из аккаунта" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding WriteMessageCommand}" Padding="12,10"
                                Visibility="{Binding CanWriteMessage, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Открыть чат" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22" helpers:SmoothScroll.IsEnabled="True">
                    <StackPanel>
                        <!-- Аватар: клик — просмотр всех фото профиля -->
                        <Button Command="{Binding OpenAvatarCommand}" HorizontalAlignment="Center" Cursor="Hand"
                                FocusVisualStyle="{x:Null}" ToolTip="Открыть фото профиля">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="132" Height="132" Background="Transparent">
                                        <!-- Кольцо -->
                                        <Ellipse StrokeThickness="3">
                                            <Ellipse.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#5CC6F7" Offset="0" />
                                                    <GradientStop Color="#2A8FD6" Offset="0.5" />
                                                    <GradientStop Color="#8E6BF5" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Stroke>
                                        </Ellipse>
                                        <Grid Margin="7">
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#5CC6F7" Offset="0" />
                                                        <GradientStop Color="#2A8FD6" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Initials}" FontSize="40" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Visibility="{Binding Avatar, Converter={StaticResource NullToVis}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"
                                                                RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse x:Name="Hover" Fill="#66000000" Opacity="0" />
                                            <TextBlock x:Name="HoverIcon" Text="&#xE721;" Style="{StaticResource Icon}" FontSize="24"
                                                       Foreground="White" HorizontalAlignment="Center" Opacity="0" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                            <Setter TargetName="HoverIcon" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Рейтинг: сразу под аватаркой (на месте «пустого» имени) -->
                        <Border HorizontalAlignment="Center" Margin="0,12,0,0" Padding="4,4,14,4" CornerRadius="16"
                                Background="{StaticResource Surface2Brush}" ToolTip="Рейтинг звёзд: текущие / до следующего уровня"
                                Visibility="{Binding HasRating, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24" Height="24">
                                    <Ellipse Fill="{StaticResource GoldGradientBrush}" />
                                    <TextBlock Text="{Binding RatingText}" FontSize="12" FontWeight="Bold" Foreground="#2A1A00"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                                    <TextBlock Text="{Binding RatingProgressText}" FontSize="12" FontWeight="SemiBold" />
                                    <Grid Height="3" Width="86" Margin="0,3,0,0" HorizontalAlignment="Left">
                                        <Border CornerRadius="1.5" Background="{StaticResource Surface3Brush}" />
                                        <Border CornerRadius="1.5" Background="{StaticResource GoldBrush}" HorizontalAlignment="Left"
                                                Width="{Binding RatingProgress, Converter={x:Static views:ProfileView.Scale}, ConverterParameter=86}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Имя: скрыто, если состоит только из невидимых символов -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Visibility="{Binding NameText, Converter={StaticResource NullToVis}}">
                            <!-- Эмодзи в имени — цветные, как в Telegram; справа — эмодзи-статус (у Premium без статуса — звезда) -->
                            <TextBlock helpers:RichText.Text="{Binding NameText}" helpers:RichText.EmojiSize="24" Style="{StaticResource H2}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="280" />
                            <controls:StickerView Width="24" Height="24" Margin="8,2,0,0" VerticalAlignment="Center" Animate="True"
                                                  CustomEmojiId="{Binding Profile.Peer.EmojiStatusId, TargetNullValue=0, FallbackValue=0}"
                                                  Visibility="{Binding Profile.Peer.EmojiStatusId, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}" />
                            <Path Data="{StaticResource StarGeometry}" Width="18" Height="18" Stretch="Uniform" Margin="8,2,0,0"
                                  Fill="{StaticResource GoldGradientBrush}" ToolTip="Telegram Premium" VerticalAlignment="Center"
                                  Visibility="{Binding ShowPremiumStar, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{StaticResource AccentBrush}" Width="18" Height="18" CornerRadius="9" Margin="6,2,0,0"
                                    ToolTip="Верифицирован" VerticalAlignment="Center"
                                    Visibility="{Binding Profile.IsVerified, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding UsernameText}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                   FontSize="15" Margin="0,8,0,0" Visibility="{Binding UsernameText, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0"
                                   Visibility="{Binding KindText, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0"
                                   Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}" />

                        <!-- Статистика -->
                        <WrapPanel Margin="0,20,-8,4">
                            <Border Style="{StaticResource StatTile}" Width="155" Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Звёзды" Style="{StaticResource Caption}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Path Style="{StaticResource StarIcon}" Width="17" Height="17" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding StarsText}" FontSize="19" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Width="155">
                                <StackPanel>
                                    <TextBlock Text="Подарков" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding CountAll}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Width="155"
                                    Visibility="{Binding HasTon, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="TON" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding TonText}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Музыка в профиле — карточка как в Telegram: обложка, название, исполнитель; фон — цвет обложки.
                             Нажатие — играть в плеере музыки (под списком чатов и в островке) -->
                        <Button Margin="0,4,0,10" Cursor="Hand" DataContext="{Binding Music}" FocusVisualStyle="{x:Null}"
                                Command="{Binding DataContext.PlayMusicCommand, ElementName=Root}"
                                Visibility="{Binding Converter={StaticResource NullToVis}}">
                            <!-- Без подсветки при наведении (раньше выделение вылезало за скругление карточки) -->
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                            <Grid helpers:RoundClip.Radius="18" Height="92">
                                <!-- Фон — сама обложка: увеличенная часть, размытая и затемнённая (нет обложки — градиент песни) -->
                                <Border Background="{Binding CoverBrush}" />
                                <!-- Края размытия — за рамкой карточки (иначе по краям просвечивал цветной фон полосой) -->
                                <Image Source="{Binding Preview}" Stretch="UniformToFill" Margin="-50" IsHitTestVisible="False">
                                    <Image.Effect>
                                        <BlurEffect Radius="26" KernelType="Gaussian" />
                                    </Image.Effect>
                                </Image>
                                <Border Background="#73000000" />
                                <DockPanel Margin="14,12">
                                    <Grid DockPanel.Dock="Left" Width="68" Height="68" Margin="0,0,16,0">
                                        <Grid helpers:RoundClip.Radius="10">
                                            <Border Background="{Binding CoverBrush}" />
                                            <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                        </Grid>
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#88000000">
                                            <Grid>
                                                <TextBlock Text="{Binding PlayIcon}" Style="{StaticResource Icon}" FontSize="12" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsLoadingAudio, Converter={StaticResource InvBoolToVis}}" />
                                                <views:Spinner Width="16" Height="16" Visibility="{Binding IsLoadingAudio, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SongTitle}" FontSize="17" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SongPerformer}" FontSize="14" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                   Visibility="{Binding SongPerformer, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                                <!-- Сколько проиграно -->
                                <Border Height="3" VerticalAlignment="Bottom" Background="#CCFFFFFF" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding PlayProgress}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Информация -->
                        <TextBlock Text="Информация" FontSize="15" FontWeight="SemiBold" Margin="2,10,0,8" />
                        <ItemsControl ItemsSource="{Binding InfoRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InfoRow}">
                                    <Border x:Name="Row" CornerRadius="10" Padding="10,9" Background="Transparent" Cursor="Hand"
                                            ToolTip="Нажмите, чтобы скопировать">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.CopyRowCommand, ElementName=Root}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Icon}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top"
                                                       Margin="0,3,14,0" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6"
                                                    FontSize="14" Content="{Binding RevealIcon}" ToolTip="Показать / скрыть"
                                                    Command="{Binding ToggleRevealCommand}"
                                                    Visibility="{Binding IsSecret, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayValue}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface2Brush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Истории профиля (у себя — ещё и архив) -->
                        <DockPanel Margin="2,14,0,8" Visibility="{Binding HasStories, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Padding="10,4" FontSize="12"
                                    Command="{Binding ToggleStoryArchiveCommand}"
                                    Visibility="{Binding IsSelfProfile, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Content" Value="Архив" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowStoryArchive}" Value="True">
                                                <Setter Property="Content" Value="Закреплённые" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="{Binding StoriesTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Историй пока нет" Style="{StaticResource Caption}" Margin="4,0,0,8"
                                   Visibility="{Binding ShowNoStories, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Stories}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProfileStoryViewModel}">
                                    <Button Width="92" Height="150" Margin="0,0,6,6" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                            Command="{Binding DataContext.OpenStoryCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid helpers:RoundClip.Radius="10">
                                                    <Border Background="{StaticResource Surface2Brush}" />
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                    <Border x:Name="Hover" Background="#22FFFFFF" Visibility="Collapsed" />
                                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Foreground="White"
                                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                                               Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="White" Margin="6,0,0,5"
                                                               VerticalAlignment="Bottom" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Подарки -->
            <!-- Группы и боты: участники / команды вместо подарков -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="22,20,8,12"
                    Visibility="{Binding ShowGifts, Converter={StaticResource InvBoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" helpers:SmoothScroll.IsEnabled="True" Padding="0,0,12,0">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasBotCommands, Converter={StaticResource BoolToVis}}" Margin="0,0,0,18">
                            <TextBlock Text="Команды бота" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Profile.BotCommands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsGroupProfile, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding MembersTitle}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <TextBlock Text="Telegram не отдаёт список участников этой группы." Style="{StaticResource Muted}"
                                       Visibility="{Binding HasMembers, Converter={StaticResource InvBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Members}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PeerResultViewModel}">
                                        <Button Style="{StaticResource CardButton}" Width="250" Margin="0,0,10,10"
                                                Command="{Binding DataContext.OpenMemberCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <DockPanel Margin="12,10">
                                                <controls:AvatarView DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" Source="{Binding Avatar}" Fill="{Binding AvatarBrush}" Initials="{Binding Initials}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock helpers:RichText.Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="22,20,8,0"
                    Visibility="{Binding ShowGifts, Converter={StaticResource BoolToVis}}">                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,14,14">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Подарки" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding CountAll}" Style="{StaticResource H2}" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Margin="10,0,0,0" Command="{Binding ToggleSelectionModeCommand}"
                                Visibility="{Binding CountConvertible, Converter={StaticResource NullToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GoldButton}">
                                    <Setter Property="Padding" Value="14,8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectionMode}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                            <Setter Property="Tag" Value="{StaticResource Surface3Brush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource StarGeometry}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Продать за звёзды" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectionMode}" Value="True">
                                                    <Setter Property="Text" Value="Отмена" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <TextBox Style="{StaticResource SearchBox}" Tag="Поиск: название, отправитель, номер…" Width="280"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    </DockPanel>

                    <!-- Фильтры и сортировка -->
                    <!-- Узкое окно: фильтры не переносятся на вторую строку, а листаются вбок (колесом или перетаскиванием полосы) -->
                    <ScrollViewer Grid.Row="1" Margin="0,0,14,10" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  helpers:SmoothScroll.HorizontalWheel="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="filter"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=All}">
                            <TextBlock><Run Text="Все" /> <Run Text="{Binding CountAll, Mode=OneWay}" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="filter"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Regular}">
                            <TextBlock><Run Text="Обычные" /> <Run Text="{Binding CountRegular, Mode=OneWay}" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="filter"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Unique}">
                            <TextBlock><Run Text="Уникальные" /> <Run Text="{Binding CountUnique, Mode=OneWay}" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="filter"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Convertible}">
                            <TextBlock><Run Text="Можно продать" /> <Run Text="{Binding CountConvertible, Mode=OneWay}" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="filter"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Hidden}">
                            <TextBlock><Run Text="Скрытые" /> <Run Text="{Binding CountHidden, Mode=OneWay}" /></TextBlock>
                        </RadioButton>

                        <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="4,0,12,0" />

                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="sort" Content="Новые"
                                     IsChecked="{Binding Sort, Converter={StaticResource EnumToBool}, ConverterParameter=Newest}" />
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="sort" Content="Старые"
                                     IsChecked="{Binding Sort, Converter={StaticResource EnumToBool}, ConverterParameter=Oldest}" />
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="sort" Content="Ценные"
                                     IsChecked="{Binding Sort, Converter={StaticResource EnumToBool}, ConverterParameter=Valuable}" />
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Панель продажи -->
                    <Border Grid.Row="2" Margin="0,0,14,14" CornerRadius="14" Padding="16,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectionMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Background" Value="#2A2414" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GoldButton}" Padding="16,9" Margin="8,0,0,0"
                                    Command="{Binding SellSelectedCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Продать выбранные" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="14,9"
                                    Content="Выбрать все" Command="{Binding SelectAllConvertibleCommand}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedSummary}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ConvertibleSummary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Сетка подарков -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" helpers:SmoothScroll.IsEnabled="True"
                                  ScrollChanged="Gifts_ScrollChanged">
                        <ItemsControl ItemsSource="{Binding ShownGifts}" ItemTemplate="{StaticResource GiftCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Колонки под ширину окна, без пустого места справа -->
                                    <controls:AdaptiveGrid MinItemWidth="172" Spacing="14" Margin="0,0,14,0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsGiftsLoading, Converter={StaticResource BoolToVis}}">
                        <views:Spinner />
                        <TextBlock Text="{Binding LoadingText}" Style="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsGiftsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE7C3;" Style="{StaticResource Icon}" FontSize="38" Foreground="{StaticResource Surface3Brush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Здесь пока пусто" Style="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================= Загрузка профиля / ошибка -->
        <Grid Grid.RowSpan="2" Background="{StaticResource BgBrush}"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:Spinner />
                <TextBlock Text="{Binding LoadingText}" Style="{StaticResource Muted}" Margin="0,14,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.RowSpan="2" Background="{StaticResource BgBrush}"
              Visibility="{Binding LoadError, Converter={StaticResource NullToVis}}">
            <Border Style="{StaticResource Panel}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <StackPanel>
                    <TextBlock Text="Не удалось загрузить профиль" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LoadError}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Выйти" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding LogoutCommand}" />
                        <Button Content="Повторить" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================= Детали подарка -->
        <Grid Grid.RowSpan="2" Visibility="Collapsed" helpers:Anim.Mode="Scale" helpers:Anim.Show="{Binding SelectedGift, Converter={x:Static views:ChatsView.NotNull}}">
            <Border Background="{StaticResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseGiftCommand}" />
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource Panel}" Width="460" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxHeight="{Binding ActualHeight, ElementName=Root, Converter={x:Static views:ProfileView.Scale}, ConverterParameter=0.92}"
                    DataContext="{Binding SelectedGift}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" helpers:SmoothScroll.IsEnabled="True">
                        <StackPanel Margin="26,26,26,22">
                            <Grid Width="220" Height="220" HorizontalAlignment="Center">
                                <Border CornerRadius="22" Background="{StaticResource Surface2Brush}" />
                                <Border CornerRadius="22" Background="{Binding Backdrop}"
                                        Visibility="{Binding Backdrop, Converter={StaticResource NullToVis}}" />
                                <Border CornerRadius="22">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0" />
                            <TextBlock Text="{Binding NumberText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Visibility="{Binding NumberText, Converter={StaticResource NullToVis}}" />

                            <!-- Отправитель -->
                            <Border HorizontalAlignment="Center" Margin="0,12,0,0" Padding="4,4,14,4" CornerRadius="16"
                                    Background="{StaticResource Surface2Brush}" Cursor="Hand" ToolTip="Открыть профиль отправителя">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenSenderCommand, ElementName=Root}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="24" Height="24">
                                        <Ellipse Fill="{StaticResource Surface3Brush}" />
                                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Ellipse Visibility="{Binding SenderAvatar, Converter={StaticResource NullToVis}}">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding SenderAvatar}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Text="{Binding FromText}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Сообщение к подарку -->
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="12" Padding="14,10" Margin="0,16,0,0"
                                    Visibility="{Binding Item.Message, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding Item.Message}" TextWrapping="Wrap" FontStyle="Italic" />
                            </Border>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,16,0,0">
                                <ItemsControl ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DetailRow}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="13" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="13" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Button Style="{StaticResource GoldButton}" Margin="0,18,0,0" Padding="18,13"
                                    Command="{Binding DataContext.SellGiftCommand, ElementName=Root}" CommandParameter="{Binding}"
                                    Visibility="{Binding CanConvert, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource StarGeometry}" Width="15" Height="15" Stretch="Uniform" Fill="#2A1A00"
                                          Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SellButtonText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Padding="18,12"
                                    Command="{Binding DataContext.OpenNftCommand, ElementName=Root}" CommandParameter="{Binding}"
                                    Visibility="{Binding Item.NftUrl, Converter={StaticResource NullToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Открыть в Telegram" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="10" ToolTip="Закрыть" Command="{Binding DataContext.CloseGiftCommand, ElementName=Root}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================= Подтверждение -->
        <Grid Grid.RowSpan="2" Visibility="Collapsed" helpers:Anim.Mode="Scale" helpers:Anim.Show="{Binding Confirm, Converter={x:Static views:ChatsView.NotNull}}">
            <Border Background="{StaticResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CancelConfirmCommand}" />
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource Panel}" Width="420" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Confirm.Title}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Confirm.Text}" Style="{StaticResource Muted}" FontSize="14" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding LoadingText}" Style="{StaticResource Caption}" Margin="0,12,0,0"
                               Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Command="{Binding CancelConfirmCommand}" IsEnabled="{Binding IsWorking, Converter={x:Static views:ProfileView.Not}}" />
                        <Button Command="{Binding AcceptConfirmCommand}" MinWidth="150">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GoldButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Confirm.IsDanger}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Tag" Value="#F06A62" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <TextBlock Text="{Binding Confirm.ActionText}"
                                           Visibility="{Binding IsWorking, Converter={StaticResource InvBoolToVis}}" />
                                <views:Spinner Width="18" Height="18" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================= Просмотр аватарок -->
        <Grid Grid.RowSpan="2" Visibility="Collapsed" helpers:Anim.Mode="Scale" helpers:Anim.Show="{Binding IsAvatarViewerOpen}">
            <Border Background="#E6050A10">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAvatarCommand}" />
                </Border.InputBindings>
            </Border>

            <Grid Margin="90,60">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" />
                    </Border.Effect>
                    <Grid>
                        <Image Source="{Binding ViewerImage}" helpers:RoundClip.Radius="12" Stretch="Uniform" MaxWidth="900"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            </Image>
                        <views:Spinner Visibility="{Binding ViewerLoading, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,16,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding ViewerCounter}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,14,0" Visibility="{Binding ViewerHasMany, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ViewerCaption}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="18,0,0,0" Padding="14,8" Command="{Binding SavePhotoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Сохранить" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="22" Padding="14" Margin="20,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White" ToolTip="Предыдущее (←)"
                    Command="{Binding PrevPhotoCommand}" Visibility="{Binding ViewerHasMany, Converter={StaticResource BoolToVis}}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="22" Padding="14" Margin="0,0,20,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" ToolTip="Следующее (→)"
                    Command="{Binding NextPhotoCommand}" Visibility="{Binding ViewerHasMany, Converter={StaticResource BoolToVis}}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="18" Margin="0,16,20,0" Foreground="White"
                    HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Закрыть (Esc)" Command="{Binding CloseAvatarCommand}" />
        </Grid>

        <!-- ================================================= Уведомление -->
        <Border Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                CornerRadius="12" Padding="18,12" MaxWidth="640"
                Visibility="{Binding Toast, Converter={StaticResource NullToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E6223140" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                            <Setter Property="Background" Value="#E67A2622" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.4" />
            </Border.Effect>
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding HideToastCommand}" />
            </Border.InputBindings>
            <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" Foreground="White" />
        </Border>
    </Grid>
</UserControl>
