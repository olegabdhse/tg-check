<UserControl x:Class="TgCheck.App.Views.MusicSidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TgCheck.App.ViewModels"
             xmlns:controls="clr-namespace:TgCheck.App.Controls"
             xmlns:views="clr-namespace:TgCheck.App.Views"
             xmlns:helpers="clr-namespace:TgCheck.App.Helpers"
             x:Name="Root">
    <!-- Играет песня, а раздел «Музыка» закрыт: плеер, поиск и подборки сбоку, песню можно сменить прямо из чата -->
    <UserControl.Resources>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Значок паузы или загрузка: общий для плеера и узкой полосы -->
        <DataTemplate x:Key="PlayGlyph">
            <Grid>
                <views:Spinner Width="16" Height="16" Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVis}}" />
                <TextBlock FontSize="14" Foreground="White" Visibility="{Binding IsBuffering, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Text" Value="&#xE768;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Text" Value="&#xE769;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Row" DataType="{x:Type vm:MusicTrackViewModel}">
            <Button x:Name="RowButton" Style="{StaticResource PlainButton}" Command="{Binding DataContext.PlayCommand, ElementName=Root}" CommandParameter="{Binding}">
                <Border x:Name="Bd" CornerRadius="10" Padding="6,5" Background="Transparent">
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,10,0">
                            <Border CornerRadius="9" Background="{Binding CoverBrush}">
                                <Path Data="{StaticResource PlaneGeometry}" Fill="#B3FFFFFF" Stretch="Uniform" Width="15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,1,0" />
                            </Border>
                            <Border CornerRadius="9">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border x:Name="Eq" CornerRadius="9" Background="#8C000000" Visibility="Collapsed">
                                <TextBlock Text="&#xE995;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,2,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="RowTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowButton}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover3Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Eq" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RowTitle" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Плитка мозаики: обложка на всю клетку, подпись поверх; размер задаёт сетка -->
        <DataTemplate x:Key="SongTile" DataType="{x:Type vm:MusicTrackViewModel}">
            <Button x:Name="TileButton" Style="{StaticResource PlainButton}" Command="{Binding DataContext.PlayCommand, ElementName=Root}" CommandParameter="{Binding}">
                <Grid>
                    <Border CornerRadius="12" Background="{Binding CoverBrush}">
                        <Path Data="{StaticResource PlaneGeometry}" Fill="#B3FFFFFF" Stretch="Uniform" Width="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Широкая плитка: фон — размытая обложка, сама обложка целиком по центру -->
                    <Border Visibility="Hidden" SizeChanged="TileBackdrop_SizeChanged">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="12">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="Uniform" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="12" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.42" />
                                <GradientStop Color="#D9000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="Shade" CornerRadius="12" Background="#4D000000" Opacity="0" IsHitTestVisible="False" />
                    <Border x:Name="Dot" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="DotIcon" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    <StackPanel VerticalAlignment="Bottom" Margin="7,0,7,6" IsHitTestVisible="False">
                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" Foreground="#CCFFFFFF" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileButton}" Value="True">
                    <Setter TargetName="Shade" Property="Opacity" Value="1" />
                    <Setter TargetName="Dot" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot" Property="Opacity" Value="1" />
                    <Setter TargetName="DotIcon" Property="Text" Value="&#xE995;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Микс: нажатие открывает его песни, кружок при наведении — сразу включает -->
        <DataTemplate x:Key="MixTile" DataType="{x:Type vm:MusicPlaylistViewModel}">
            <Button x:Name="TileButton" Style="{StaticResource PlainButton}" Margin="3" Command="{Binding DataContext.OpenPlaylistCommand, ElementName=Root}" CommandParameter="{Binding}">
                <StackPanel>
                    <Grid Height="104">
                        <Border CornerRadius="12" Background="{Binding CoverBrush}" />
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="Shade" CornerRadius="12" Background="#4D000000" Opacity="0" IsHitTestVisible="False" />
                        <Button x:Name="Dot" Style="{StaticResource PlainButton}" Width="34" Height="34" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding DataContext.PlayWholePlaylistCommand, ElementName=Root}" CommandParameter="{Binding}">
                            <Border CornerRadius="17" Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,5,2,0" />
                    <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="2,0,2,0" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileButton}" Value="True">
                    <Setter TargetName="Shade" Property="Opacity" Value="1" />
                    <Setter TargetName="Dot" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Чат с музыкой в полке: круглая аватарка, как в списке чатов; нажатие открывает его песни, кружок — включает -->
        <DataTemplate x:Key="ChatTile" DataType="{x:Type vm:MusicPlaylistViewModel}">
            <Button x:Name="TileButton" Style="{StaticResource PlainButton}" Width="68" Margin="2,0" Command="{Binding DataContext.OpenPlaylistCommand, ElementName=Root}" CommandParameter="{Binding}">
                <StackPanel>
                    <Grid Width="54" Height="54" HorizontalAlignment="Center">
                        <Ellipse Fill="{Binding CoverBrush}" />
                        <TextBlock Text="{Binding Initial}" FontSize="19" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="Shade" Fill="#59000000" Opacity="0" IsHitTestVisible="False" />
                        <Button x:Name="Dot" Style="{StaticResource PlainButton}" Width="28" Height="28" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding DataContext.PlayWholePlaylistCommand, ElementName=Root}" CommandParameter="{Binding}">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileButton}" Value="True">
                    <Setter TargetName="Shade" Property="Opacity" Value="1" />
                    <Setter TargetName="Dot" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="3,0,0,7" />
        </Style>

        <!-- Раздел результатов поиска: пустой необязательный не показываем -->
        <DataTemplate x:Key="Group" DataType="{x:Type vm:MusicShelf}">
            <StackPanel Margin="0,0,0,10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="8,4,0,4" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Row}" Focusable="False" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Ширину задаёт код: полоса раскрывается влево, чат сжимается вместе с ней -->
    <Border x:Name="Card" Style="{StaticResource Panel}" Padding="0" HorizontalAlignment="Right" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            SizeChanged="Card_SizeChanged" MouseMove="Card_MouseMove" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
        <Grid>
            <!-- ================================================= Панель целиком: сверху поиск, снизу плеер и полка чатов -->
            <DockPanel x:Name="FullPanel" Width="358" HorizontalAlignment="Right">
                <DockPanel DockPanel.Dock="Top" Margin="12,12,8,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="11" Padding="8" Margin="4,0,0,0" VerticalAlignment="Center"
                            DataContext="{x:Static vm:MusicNow.Instance}" Command="{Binding ToggleSidePanelCommand}" />
                    <Grid>
                        <TextBox Style="{StaticResource SearchBox}" Padding="34,8,32,8" FontSize="13" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Найти песню…" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" IsHitTestVisible="False" VerticalAlignment="Center" Margin="35,0,0,0"
                                   Visibility="{Binding IsSearch, Converter={StaticResource InvBoolToVis}}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="7" HorizontalAlignment="Right" Margin="0,0,3,0"
                                Command="{Binding ClearQueryCommand}" Visibility="{Binding IsSearch, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DockPanel>

                <!-- Слушают в чатах: всегда внизу, листается в сторону как полка -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,2,0,10" DataContext="{Binding AllChatPlaylists}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="15,0,0,6" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="10,0" PreviewMouseWheel="ChatShelf_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ChatTile}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Плеер: скруглённая карточка над чатами; обложка, название, полоска со временем по краям, кнопки -->
                <Grid x:Name="PlayerCard" DockPanel.Dock="Bottom" Margin="10,6,10,10" ClipToBounds="True" SizeChanged="PlayerCard_SizeChanged"
                      DataContext="{x:Static vm:MusicNow.Instance}">
                    <Border Background="{Binding CoverBrush}" />
                    <Border Opacity="0.9" Margin="-50">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance" />
                        </Border.Effect>
                        <Border.CacheMode>
                            <BitmapCache RenderAtScale="0.4" />
                        </Border.CacheMode>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#40000000" Offset="0" />
                                <GradientStop Color="#B3000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="14,14,14,10">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="112" Height="112" Margin="0,0,14,0">
                                <Grid.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" />
                                </Grid.Effect>
                                <Border CornerRadius="14" Background="{Binding CoverBrush}">
                                    <Path Data="{StaticResource PlaneGeometry}" Fill="#B3FFFFFF" Stretch="Uniform" Width="42" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding Cover, Converter={StaticResource InvNullToVis}}" />
                                </Border>
                                <Border CornerRadius="14">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <views:Spinner Width="26" Height="26" Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <Button DockPanel.Dock="Right" Style="{StaticResource HeartButton}" Tag="{Binding IsLiked}" Command="{Binding ToggleLikeCommand}" VerticalAlignment="Top" Margin="2,-4,-6,0"
                                    Visibility="{Binding CanLike, Converter={StaticResource BoolToVis}}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="White" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid x:Name="Seek" Height="18" Margin="0,10,0,0" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="Seek_Down" MouseMove="Seek_Move" MouseLeftButtonUp="Seek_Up">
                            <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center" />
                            <Border Height="4" CornerRadius="2" Background="White" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Progress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" FontSize="11" Foreground="#CCFFFFFF" />
                            <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="#CCFFFFFF" />
                        </DockPanel>
                        <Grid Margin="0,4,0,0">
                            <Button Content="&#xE8EE;" FontSize="15" Padding="9" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding ToggleLoopCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Foreground" Value="#CCFFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Loop}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="18" Padding="10" VerticalAlignment="Center"
                                        Foreground="White" Command="{Binding DataContext.PreviousCommand, ElementName=Root}" />
                                <Button Style="{StaticResource RoundButton}" Width="48" Height="48" Margin="10,0" VerticalAlignment="Center" Command="{Binding ToggleCommand}">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlayGlyph}" Focusable="False" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="18" Padding="10" VerticalAlignment="Center"
                                        Foreground="White" Command="{Binding DataContext.NextCommand, ElementName=Root}" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" Padding="10" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#CCFFFFFF" Click="Close_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid>
                    <!-- Открытый плейлист: песни прямо здесь, можно не уходить из чата -->
                    <DockPanel Visibility="{Binding IsPlaylistPage, Converter={StaticResource BoolToVis}}">
                        <DockPanel DockPanel.Dock="Top" Margin="8,0,12,6">
                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="12" Padding="8" VerticalAlignment="Center"
                                    Command="{Binding ClosePlaylistCommand}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12" VerticalAlignment="Center"
                                    Command="{Binding PlayPlaylistCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Слушать" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Margin="4,0,8,0">
                                <TextBlock Text="{Binding OpenedPlaylist.Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding OpenedPlaylist.CountText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" helpers:SmoothScroll.IsEnabled="True">
                            <Grid Margin="6,0,6,6" DataContext="{Binding PlaylistPage}">
                                <views:Spinner Width="20" Height="20" Margin="0,16" VerticalAlignment="Top" Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Row}" Focusable="False" />
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" helpers:SmoothScroll.IsEnabled="True"
                                  Visibility="{Binding IsPlaylistPage, Converter={StaticResource InvBoolToVis}}">
                        <Grid Margin="6,0,6,6">
                            <!-- Найденное -->
                            <StackPanel Visibility="{Binding IsSearch, Converter={StaticResource BoolToVis}}">
                                <views:Spinner Width="20" Height="20" Margin="0,8" Visibility="{Binding IsSearchLoading, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding SearchShelves}" ItemTemplate="{StaticResource Group}" Focusable="False" />
                            </StackPanel>
                            <!-- Часть страницы «Музыка»: у каждого раздела своя раскладка -->
                            <StackPanel Margin="6,0,6,0" Visibility="{Binding IsSearch, Converter={StaticResource InvBoolToVis}}">
                                <StackPanel Margin="0,0,0,16" DataContext="{Binding NextForYou}">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SongTile}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:MosaicPanel Limit="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="Начните слушать музыку, чтобы мы могли подобрать треки для вас" TextWrapping="Wrap" FontSize="12.5" Margin="3,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsLoading}" Value="False" />
                                                            <Condition Binding="{Binding Items.Count}" Value="0" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Margin="-3,0,-3,13" DataContext="{Binding MyPlaylists}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="6,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource MixTile}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" VerticalAlignment="Top" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16" DataContext="{Binding Favorites}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SongTile}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:MosaicPanel Mirror="True" Limit="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16" DataContext="{Binding MoreFromArtists}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SongTile}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:MosaicPanel Big="False" Limit="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,6" DataContext="{Binding InChats}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SongTile}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:MosaicPanel Limit="9" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- ================================================= Скрытая панель: сверху песня и её кнопки, ниже волны.
                 Наведение на волны (пустое место) раскрывает панель, стрелка закрепляет её открытой -->
            <DockPanel x:Name="StripPanel" Width="62" HorizontalAlignment="Right" Visibility="Collapsed" Background="Transparent" DataContext="{x:Static vm:MusicNow.Instance}">
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0" Background="Transparent">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="10" Padding="7" HorizontalAlignment="Center" Command="{Binding ToggleSidePanelCommand}" />
                    <Grid Width="46" Height="46" Margin="0,4,0,8" HorizontalAlignment="Center">
                        <Border CornerRadius="12" Background="{Binding CoverBrush}" />
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <Button Style="{StaticResource RoundButton}" Width="40" Height="40" HorizontalAlignment="Center" Command="{Binding ToggleCommand}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlayGlyph}" Focusable="False" />
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="11" Padding="7" Foreground="{DynamicResource TextBrush}" Command="{Binding DataContext.PreviousCommand, ElementName=Root}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="11" Padding="7" Foreground="{DynamicResource TextBrush}" Command="{Binding DataContext.NextCommand, ElementName=Root}" />
                    </StackPanel>
                    <!-- Название вдоль полосы, не длиннее заданного: ниже остаётся место волнам -->
                    <Grid Height="150" Margin="0,8,0,0" ClipToBounds="True" Background="Transparent">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="150">
                            <StackPanel.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </StackPanel.LayoutTransform>
                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource HeartButton}" Tag="{Binding IsLiked}" Command="{Binding ToggleLikeCommand}" HorizontalAlignment="Center" Margin="0,4,0,10"
                        Visibility="{Binding CanLike, Converter={StaticResource BoolToVis}}" />
                <controls:StripWaves x:Name="Waves" Margin="10,10,10,10" IsHitTestVisible="False" BarBrush="{DynamicResource AccentBrush}" Level="{Binding Level}" IsPlaying="{Binding IsPlaying}" />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
