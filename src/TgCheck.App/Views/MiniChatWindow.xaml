<Window x:Class="TgCheck.App.Views.MiniChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TgCheck.App.Views"
        xmlns:helpers="clr-namespace:TgCheck.App.Helpers"
        Title="TG Check — чат" Width="420" Height="720" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource TextBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Отступ под тень -->
    <Grid Margin="16,4,16,20">
        <!-- Тень — на отдельной пустой подложке: не пересчитывается при изменениях в чате -->
        <Border x:Name="Shadow" CornerRadius="22" Background="#0B1016">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.6" />
            </Border.Effect>
        </Border>
        <Border x:Name="Card" CornerRadius="22" Background="{StaticResource SurfaceBrush}" BorderBrush="#26FFFFFF" BorderThickness="1"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" />
            </Border.RenderTransform>
            <Grid helpers:RoundClip.Radius="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Полоса окна: назад в приложение / закрыть; за неё можно перетаскивать -->
                <Border Background="#0B1016" Padding="6,5" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Открыть в приложении"
                                Click="Back_Click" Padding="8" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Закрыть (Esc)"
                                Click="Close_Click" Padding="8" FontSize="13" />
                        <Border Width="36" Height="4" CornerRadius="2" Background="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <views:ConversationView x:Name="Chat" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
