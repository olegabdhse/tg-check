<Window x:Class="TgCheck.App.Views.MiniChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TgCheck.App.Views"
        xmlns:controls="clr-namespace:TgCheck.App.Controls"
        xmlns:helpers="clr-namespace:TgCheck.App.Helpers"
        Title="TG Check — чат" Width="390" Height="720" WindowStyle="None" Background="{StaticResource SurfaceBrush}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource TextBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Обычное (не прозрачное) окно: углы и тень рисует Windows — без программной перерисовки и мерцания -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="Card" Background="{StaticResource SurfaceBrush}"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Полоса окна: назад в приложение / закрыть; за неё можно перетаскивать -->
                <Border Background="#0B1016" Padding="6,5" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Открыть в приложении"
                                Click="Back_Click" Padding="8" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Закрыть (Esc)"
                                Click="Close_Click" Padding="8" FontSize="13" />
                        <!-- Последние чаты — переключение прямо в мини-окне (как в панели основного окна) -->
                        <ItemsControl x:Name="ChatSwitcher" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:MiniChatItem}">
                                    <Button Width="34" Height="34" Margin="3,0" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding Chat.Title}"
                                            Click="Switch_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <controls:AvatarView Width="34" Height="34" Source="{Binding Chat.Avatar}" Fill="{Binding Chat.AvatarBrush}"
                                                                 Initials="{Binding Chat.Initials}" Ring="{Binding Ring}" />
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" Stroke="#0B1016" StrokeThickness="1.5"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Visibility="{Binding Chat.HasUnread, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Grid x:Name="ChatHost" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
