<UserControl x:Class="TgCheck.App.Views.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="36" Height="36" IsHitTestVisible="False">
    <Viewbox>
        <Canvas Width="36" Height="36">
            <Ellipse Width="36" Height="36" Stroke="{StaticResource Surface3Brush}" StrokeThickness="3.5" />
            <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M18,1.75 A16.25,16.25 0 0 1 34.25,18" RenderTransformOrigin="0.5,0.5" Width="36" Height="36" Stretch="None">
                <Path.RenderTransform>
                    <RotateTransform x:Name="Rot" />
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Viewbox>
</UserControl>
