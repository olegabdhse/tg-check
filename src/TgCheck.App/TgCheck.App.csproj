<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен только для значка в трее (NotifyIcon); его пространства имён не подключаем глобально. -->
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TgCheck</AssemblyName>
    <RootNamespace>TgCheck.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>TG Check</Product>
    <!-- Иконка exe берётся из папки logo\ (см. build\Logo.targets). Нет картинки — нет иконки. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TgCheck.Core\TgCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <Import Project="..\..\build\Logo.targets" />

</Project>
