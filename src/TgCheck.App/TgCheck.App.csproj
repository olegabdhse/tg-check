<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен только для значка в трее (NotifyIcon); его пространства имён не подключаем глобально. -->
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TgCheck</AssemblyName>
    <RootNamespace>TgCheck.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>TG Check</Product>
    <!-- Иконка exe берётся из папки logo\ (см. build\Logo.targets). Нет картинки — нет иконки. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TgCheck.Core\TgCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.154.0" />
    <!-- Видеоплеер на движке VLC: играет любые форматы (webm, HEVC, mkv…), которых нет у встроенного плеера Windows. -->
    <PackageReference Include="LibVLCSharp" Version="3.9.0" />
    <!-- Нативный VLC: в вывод не копируется (ExcludeAssets) — нужные файлы пакуются в exe архивом (см. EmbedVlc). -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Ключи из .env (в корне проекта) зашиваются в exe: скачанная из релиза программа работает без своего .env.
       В git файла нет; .env рядом с exe, если он есть, важнее зашитого. -->
  <!-- Встраиваются в зашифрованном виде (build\embed-env.ps1): в exe нет ключей открытым текстом. -->
  <PropertyGroup>
    <EnvSource>$(MSBuildThisFileDirectory)..\..\.env</EnvSource>
    <EnvBlob>$(MSBuildProjectDirectory)\obj\env.bin</EnvBlob>
  </PropertyGroup>

  <Target Name="EncryptEnv" Condition="Exists('$(EnvSource)')"
          Inputs="$(EnvSource);$(MSBuildThisFileDirectory)..\..\build\embed-env.ps1" Outputs="$(EnvBlob)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\embed-env.ps1&quot; -EnvFile &quot;$(EnvSource)&quot; -OutFile &quot;$(EnvBlob)&quot;" />
  </Target>

  <Target Name="EmbedEnv" BeforeTargets="BeforeBuild" DependsOnTargets="EncryptEnv" Condition="Exists('$(EnvSource)')">
    <ItemGroup>
      <EmbeddedResource Include="$(EnvBlob)" LogicalName="TgCheck.embedded.env" />
    </ItemGroup>
  </Target>

  <!-- VLC для видео: нужная часть (~45 МБ) пакуется в zip и встраивается в exe; распаковывается один раз,
       при первом видео (см. Helpers\VlcRuntime.cs) — запуск программы от этого не замедляется. -->
  <PropertyGroup>
    <VlcSource>$(PkgVideoLAN_LibVLC_Windows)\build\x64</VlcSource>
    <VlcZip>$(MSBuildProjectDirectory)\obj\vlc-3.0.21.zip</VlcZip>
  </PropertyGroup>

  <Target Name="PackVlc" Inputs="$(MSBuildThisFileDirectory)..\..\build\pack-vlc.ps1" Outputs="$(VlcZip)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\pack-vlc.ps1&quot; -Source &quot;$(VlcSource)&quot; -OutFile &quot;$(VlcZip)&quot;" />
  </Target>

  <Target Name="EmbedVlc" BeforeTargets="BeforeBuild" DependsOnTargets="PackVlc">
    <ItemGroup>
      <EmbeddedResource Include="$(VlcZip)" LogicalName="TgCheck.vlc.zip" />
    </ItemGroup>
  </Target>

  <Import Project="..\..\build\Logo.targets" />

</Project>
