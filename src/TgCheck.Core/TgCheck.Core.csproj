<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TgCheck.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Официальный MTProto API Telegram (api_id / api_hash с my.telegram.org) -->
    <PackageReference Include="WTelegramClient" Version="4.4.9" />
    <!-- Голосовые сообщения: декодер Opus/Ogg и вывод звука -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Рендер стикеров подарков (.tgs = Lottie) и webp -->
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.Skottie" Version="4.154.0" />
    <!-- Шифрование файла сессии через Windows DPAPI -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
