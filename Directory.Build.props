<Project>
  <PropertyGroup>
    <!-- Версия приложения. release.ps1 передаёт её через -p:Version=... -->
    <Version Condition="'$(Version)' == ''">2.0.0</Version>
    <!-- GitHub-репозиторий для автообновлений (owner/repo). Пусто — проверка обновлений выключена. -->
    <UpdateRepo Condition="'$(UpdateRepo)' == ''">olegabdhse/tg-check</UpdateRepo>
  </PropertyGroup>

  <ItemGroup Condition="'$(UpdateRepo)' != ''">
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>
</Project>
